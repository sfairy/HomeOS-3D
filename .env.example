# HomeOS 环境变量模板
#
#   cp .env.example .env
#
# .env 不入库；本文件只放占位符。全部默认注释掉：复制不改也能启动。
#
# 优先级：真实环境变量 > .env > 代码 / start.py 默认值
# 布尔：1 / on / yes / true；含空格或 # 请加引号。
#
# 本文件只保留「环境变量专属」项。以下请到商店 /admin「站点配置」改（免重启）：
#   站点名 / 公告 / 客服 / 维护 / 邀请提现、解绑冷却、验证码 TTL、
#   邮件与 SMTP、支付渠道、支付宝商户号与密钥 / 回调 / 交易标题 等。
#
# 下面带等号的行都是「示例默认值」；没有列出的项请保持不写，让程序用内置默认。


# ═════════════════════════════════════════════════════════════════════
# A. 部署常改（域名 / 反代）
# ═════════════════════════════════════════════════════════════════════

#APP_BASE_URL=https://homeos.example.com
# 默认 compose 内网即可；仅当授权站不在同 compose 网络时才改
#APP_LICENSE_SERVER_URL=http://homeos-3d-store:18082
#APP_TRUSTED_PROXIES=10.0.0.1/32
# uvicorn 的转发头信任范围。默认只信回环（127.0.0.1,::1），**不要填 ***：
# 那等于让客户端自己写来源 IP，限流与审计会一起失效。
# 前面有反向代理时填代理自身的地址或网段（宿主机反代常见 172.17.0.1）。
#UVICORN_FORWARDED_ALLOW_IPS=172.17.0.1
#APP_COOKIE_SECURE=true

#STORE_BASE_URL=https://pay.example.com
#STORE_TRUSTED_PROXIES=10.0.0.1/32
#STORE_COOKIE_SECURE=true

# 模拟收银台总闸（仅本地联调）。生产保持 false；真实渠道在 /admin 配置。
#STORE_ALLOW_MOCK_PAYMENTS=false

# 管理员不走环境变量：首次部署后请在浏览器打开 http://<商店地址>:18082/setup 创建账号
# （早期版本支持的 STORE_ADMIN_EMAIL / STORE_ADMIN_PASSWORD 预置路径已移除）


# ═════════════════════════════════════════════════════════════════════
# B. 主应用——路径 / 会话 / 中控 / HA（默认即可）
# ═════════════════════════════════════════════════════════════════════

#APP_DATA_DIR=./data
#APP_PORT=18081
#APP_SESSION_MAX_AGE_SECONDS=28800
#APP_SESSION_HARD_MAX_AGE_SECONDS=2592000
#APP_DISPLAY_COOKIE_MAX_AGE_SECONDS=15552000
#APP_DISPLAY_TOKEN_TTL_SECONDS=15552000
#APP_DISPLAY_TOKEN_HARD_TTL_SECONDS=0
#APP_UPDATE_CHANNEL=docker
#APP_HA_REQUEST_TIMEOUT_SECONDS=10
#APP_HA_RECONCILE_INTERVAL_SECONDS=1800
#APP_HA_WEBSOCKET_MAX_SIZE_BYTES=67108864
#APP_LICENSE_REQUEST_TIMEOUT_SECONDS=10
#APP_LICENSE_SERVER_BATCHES=esa=;eo=;direct=http://127.0.0.1:18082
# keyId 默认由公钥文件派生（两侧各自算、结果相同），一般不用设；
# 显式设置会固定名字，轮换时两边必须同步改。
#APP_LICENSE_KEY_ID=hb-local-2026
#APP_LICENSE_PUBLIC_KEY_FILE=keys/license-public.pem
#APP_LICENSE_TRANSPORT_KEY_ID=hb-local-transport-2026
#APP_LICENSE_TRANSPORT_PUBLIC_KEY_FILE=keys/license-transport-public.pem
#APP_HA_CREDENTIAL_FILE=/run/secrets/ha_credentials.key
#APP_DISPLAY_PAIRING_KEY_FILE=/run/secrets/display_pairing_codes.key
#APP_LICENSE_CREDENTIAL_FILE=/run/secrets/license_credentials.key

# 授权实例指纹（硬件绑定）。留空 = 由本机机器 / 主板标识派生（容器里读宿主的
# /host/etc/machine-id 与 DMI，宿主侧准备见 docker-compose.app.yml）。
# 显式填一组值 = **钉住**实例身份，用途：
#   - 宿主机拿不到稳定标识（ARM、精简虚拟机），或容器重建后指纹漂移；
#   - 跨服务器迁移：填成旧机器那一组值，商店就不会判成「换设备」。
# 改动它等价于换设备 —— 商店侧是 1 授权 : 1 绑定，对不上会以 409「已绑定其他设备」
# 拒绝，需要先在商店后台或账号中心解绑（有冷却）再激活。
#APP_HARDWARE_MACHINE_ID=
#APP_HARDWARE_BOARD_ID=

# 以下一般不用设（不写 = 用内置行为）：
# - APP_SETUP_TOKEN：首次启动自动生成并写入 data/setup-token
# - APP_LICENSE_*_SHA256：默认用代码里与 keys/ 匹配的指纹
# - APP_LICENSE_TRUSTED_PUBLIC_KEYS：仅密钥轮换时才需要


# ═════════════════════════════════════════════════════════════════════
# C. 商店——基础设施（后台改不了）
# ═════════════════════════════════════════════════════════════════════

# 这一节的数值/布尔变量在商店启动时**严格解析**：写错（如 STORE_ORDER_TTL_SECONDS=12o、
# STORE_COOKIE_SECURE=ture）会让进程带着一条点名变量的错误拒绝启动，而不是静默用默认值。
# 只有「不写」或「留空」才用默认值。布尔值接受 true/false/1/0/yes/no/on/off。
# 原因：静默回退的后果大多不止「少个功能」—— STORE_COOKIE_SECURE 拼错恰好等于关闭，
# HTTPS 部署的会话 Cookie 会因此丢掉 Secure，而服务照常运行、日志里没有提示。

#STORE_HOST=0.0.0.0
#STORE_PORT=18082
#STORE_DATA_DIR=store/data
#STORE_LICENSE_KEYS_DIR=store/keys/local
# 授权 keyId：**默认留空即可** —— 服务端与客户端都从公钥文件字节派生
# （形如 hb-3f2a...），于是重新生成密钥时名字必然跟着变，客户端不会把新公钥
# 误报成「指纹不匹配」。只有联调或老部署才需要显式钉住，那种情况下轮换必须
# 服务端与客户端同步改（APP_LICENSE_KEY_ID / APP_LICENSE_TRANSPORT_KEY_ID）。
#STORE_LICENSE_KEY_ID=hb-local-2026
#STORE_LICENSE_TRANSPORT_KEY_ID=hb-local-transport-2026
# 密钥轮换的重叠窗口：把上一代四件套（license-*.previous.pem）放在
# STORE_LICENSE_KEYS_DIR 下即自动生效 —— 旧客户端在窗口内仍可解密与验签；
# 删掉这四个文件窗口立即关闭。
# 租约有效期（秒）。注意这个值同时决定两件事：客户端离线可用多久，
# 以及「吊销生效上界」—— 停用授权/解绑设备对一台持续离线的客户端最慢要多久才生效。
#STORE_LEASE_TTL_SECONDS=259200
#STORE_HEARTBEAT_INTERVAL_SECONDS=300
# /v2/heartbeat 与 /v2/recover 的来源 IP 小时配额（/v2/activate 固定 60/小时，不在此列）。
# 心跳与恢复收的是高熵令牌、不是枚举面，却同时来自后台心跳与「授权页开着时的状态轮询」，
# 所以额度放得很宽。它按**出口地址**统计：多台设备共用一个 NAT 出口时会叠加，
# 出现「授权页卡住 + 日志里一片 429」时把它调大即可。
#STORE_LICENSE_SESSION_IP_HOURLY_LIMIT=3600
#STORE_ORDER_TTL_SECONDS=120
#STORE_SESSION_MAX_AGE_SECONDS=2592000
#STORE_COOKIE_NAME=ha_bridge_store_session
#STORE_PAYMENT_SWEEP_INTERVAL_SECONDS=30
#STORE_PAYMENT_SWEEP_BATCH=25
#STORE_EXPOSE_VERIFICATION_CODE=false
# 验证码发信的全站小时上限（所有来源合计）。这是防「拿商店当发信机轰炸第三方」
# 的兜底闸门：额度之内按来源 IP（20/小时）与单邮箱（10/小时）各自再限一层，
# 超出全站上限时**所有人**都会暂时收不到验证码（日志会打 ERROR 提示调高）。
# 正常业务量下把小时发信量估出来，留一倍余量即可。
#STORE_VERIFICATION_GLOBAL_HOURLY_LIMIT=500
# 暴露 /store-api-docs（全部端点与参数结构）。默认关闭 —— 开了等于给攻击者
# 一份现成的端点清单。只在本地联调时打开。
#STORE_EXPOSE_API_DOCS=false
#STORE_ALIPAY_SIGN_TYPE=RSA2
#STORE_ALIPAY_VERIFY_RESPONSE=true

# 以下一般不用设：
# - STORE_RELOAD：仅本地 start.py 会打开热重载
# - STORE_ALIPAY_*_KEY_PATH：容器可用文件挂载密钥；也可用 /admin 填内联 PEM


# ═════════════════════════════════════════════════════════════════════
# D. 管理员账号
# ═════════════════════════════════════════════════════════════════════
#
# 不再支持通过环境变量或命令行预置管理员 —— 请在浏览器打开 /setup 页面创建。
