# HomeOS 本地配置模板
#
# 用法：把本文件复制为仓库根目录的 .env，然后按需取消注释。
#
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会进版本库；本文件（.env.example）需要随仓库分发，
# 因此**只能放占位符**，任何真实凭据都不要写进来。
#
# 优先级：真实环境变量 > .env > 代码 / start.py 默认值
# （store/env.py 只在环境变量不存在时注入，所以容器/CI 里的真实变量总是优先。）
#
# 几个约定：
# - 布尔值接受 1 / on / yes / true（不区分大小写），其余一律按 false 处理。
# - 值里含空格或 "#" 时请用成对引号包裹，例如 STORE_ADMIN_PASSWORD="a b#c"；
#   未加引号时，行尾 " #" 之后的内容会被当成注释丢掉。
# - 本文件全部默认注释掉：直接复制不改也能正常启动，等价于没有 .env。
# - 站点名、公告、客服邮箱、维护模式、邀请比例、提现手续费等**运行时配置**存在
#   数据库里，请在 /admin 的「站点配置」里改，不要往这里写。


# ─────────────────────────────────────────────────────────────────────
# 主应用（backend/app/config.py）—— 默认即可跑，通常只在反代/容器里改
# ─────────────────────────────────────────────────────────────────────

# 运行时数据目录（数据库、密钥、上传资源、3D 草稿）。容器内为 /data。
#APP_DATA_DIR=./data

# 对外访问根地址。反代部署时建议设置：WebSocket 会用它校验 Origin。
#APP_BASE_URL=https://homeos.example.com

# 容器监听端口，由容器镜像的启动命令使用（代码本身不读取该变量）。
#APP_PORT=18081

# 登录会话时长（秒）。默认 28800（8 小时）。
#APP_SESSION_MAX_AGE_SECONDS=28800

# 站点走 HTTPS 时设为 true，让会话 Cookie 带上 Secure 标记。
#APP_COOKIE_SECURE=false

# 更新检查渠道：docker / addon。主应用只在 docker、addon 两种渠道下发起检查。
#APP_UPDATE_CHANNEL=docker

# 调用 Home Assistant 的超时（秒）与全量对账间隔（秒）。
#APP_HA_REQUEST_TIMEOUT_SECONDS=10
#APP_HA_RECONCILE_INTERVAL_SECONDS=1800

# HA WebSocket 单条消息上限（字节）。默认 67108864（64 MiB）。
#APP_HA_WEBSOCKET_MAX_SIZE_BYTES=67108864

# 授权服务器地址。默认指向本机商店 18082，零配置即可在 /license 激活。
#APP_LICENSE_SERVER_URL=http://127.0.0.1:18082

# 多批次授权服务器覆盖项（JSON）。只有需要按批次分发到不同授权服务器时才用。
# 单条直连（默认）时不需要设置。
#APP_LICENSE_SERVER_BATCHES=[]

# 授权请求超时（秒）。
#APP_LICENSE_REQUEST_TIMEOUT_SECONDS=10

# 授权签名公钥的 keyId 与公钥文件路径 / 文件字节 sha256。
# 默认读取仓库内 keys/，与 store/keys/local/ 必须逐字节一致。
#APP_LICENSE_KEY_ID=hb-local-2026
#APP_LICENSE_PUBLIC_KEY_FILE=keys/license-public.pem
#APP_LICENSE_PUBLIC_KEY_SHA256=

# 授权传输公钥（X25519）的 keyId 与公钥文件路径 / sha256。
#APP_LICENSE_TRANSPORT_KEY_ID=hb-local-transport-2026
#APP_LICENSE_TRANSPORT_PUBLIC_KEY_FILE=keys/license-transport-public.pem
#APP_LICENSE_TRANSPORT_PUBLIC_KEY_SHA256=

# 多把受信公钥的覆盖项（JSON），用于轮换密钥时同时信任新旧公钥。
#APP_LICENSE_TRUSTED_PUBLIC_KEYS=

# 三类本地密钥文件的落盘位置。默认在数据目录内；容器里通常挂到 /run/secrets/。
#APP_HA_CREDENTIAL_FILE=/run/secrets/ha_credentials.key
#APP_DISPLAY_PAIRING_KEY_FILE=/run/secrets/display_pairing_codes.key
#APP_LICENSE_CREDENTIAL_FILE=/run/secrets/license_credentials.key

# 授权校验始终开启，不能用环境变量关闭；激活只连接自建授权服务器。


# ─────────────────────────────────────────────────────────────────────
# 授权商店（store/config.py）—— 通用
# ─────────────────────────────────────────────────────────────────────

# 监听地址与端口。start.py 本地联调时固定为 127.0.0.1:18082。
#STORE_HOST=0.0.0.0
#STORE_PORT=18082

# SQLite 与商品图目录。默认 store/data。
#STORE_DATA_DIR=store/data

# 生成支付二维码、支付回调链接用的外部基址。留空时按请求推导。
#STORE_BASE_URL=https://pay.example.com

# 授权密钥目录（私钥，不入库）。默认 store/keys/local。
#STORE_LICENSE_KEYS_DIR=store/keys/local

# 下发给客户端签名租约用的 keyId，必须与主应用 APP_LICENSE_KEY_ID 对应。
#STORE_LICENSE_KEY_ID=hb-local-2026

# 传输密钥（X25519）的 keyId，必须与主应用 APP_LICENSE_TRANSPORT_KEY_ID 对应。
#STORE_LICENSE_TRANSPORT_KEY_ID=hb-local-transport-2026

# 租约有效期与心跳间隔（秒）。默认 7 天 / 300 秒。
#STORE_LEASE_TTL_SECONDS=604800
#STORE_HEARTBEAT_INTERVAL_SECONDS=300

# 订单有效期（秒）。默认 120；接真实收款前必须调大（否则用户还没付完单就过期）。
#STORE_ORDER_TTL_SECONDS=120

# 设备自助解绑的冷却时长（秒）。默认 28800（8 小时）。
# 也可在后台「站点配置」里覆盖：后台配置优先于 .env。
#STORE_DEVICE_RELEASE_COOLDOWN_SECONDS=28800

# 验证码有效期与重发冷却（秒）。默认 600 / 60。
# 也可在后台「站点配置 → 注册邮箱验证码」里改：后台非 0 则覆盖这里。
# 冷却必须短于有效期，否则用户会在验证码过期后被冷却锁住，无法重新获取。
#STORE_VERIFICATION_TTL_SECONDS=600
#STORE_VERIFICATION_COOLDOWN_SECONDS=60

# 商店会话有效期（秒）。默认 2592000（30 天）。
#STORE_SESSION_MAX_AGE_SECONDS=2592000

# 会话 Cookie 名称与 Secure 标记。走 HTTPS 时把 Secure 设为 true。
#STORE_COOKIE_NAME=ha_bridge_store_session
#STORE_COOKIE_SECURE=false

# 是否在接口响应里回显验证码。仅供本地联调，生产必须保持 false。
#STORE_EXPOSE_VERIFICATION_CODE=false

# 本地热重载开关。start.py 会自动设为 1；生产请勿开启。
#STORE_RELOAD=


# ─────────────────────────────────────────────────────────────────────
# 授权商店 —— 邮件（注册/找回密码的验证码投递）
# ─────────────────────────────────────────────────────────────────────
#
# 下面每一项都能在后台「站点配置 → 注册邮箱验证码」里改，改完**立刻生效、免重启**：
# 后台留空 / 填 0 表示「跟随这里的环境变量」，填了值就以后台为准。SMTP 授权码
# 在后台只显打码值，留空不改动、勾「清除」才回到环境变量。

# log：只写日志；echo：写入日志并在接口响应里回显（本地联调默认）；
# smtp：真实发信（start.py 之外的部署需要显式设置）。
#STORE_MAIL_MODE=log

# 发件人地址（带显示名时用引号，值里有空格）。
#STORE_MAIL_FROM="HomeOS <no-reply@habridge.local>"

# SMTP 服务器。_PASSWORD 一般填邮箱的 SMTP 授权码，不是登录密码。
# STORE_SMTP_USE_SSL / STORE_SMTP_STARTTLS 只能二选一；后台对应一个下拉框
# （ssl / starttls / plain），选了加密方式却忘了填端口时会自动补 465 / 587 / 25。
#STORE_SMTP_HOST=smtp.example.com
#STORE_SMTP_PORT=465
#STORE_SMTP_USERNAME=no-reply@example.com
#STORE_SMTP_PASSWORD=
#STORE_SMTP_USE_SSL=true
#STORE_SMTP_STARTTLS=false


# ─────────────────────────────────────────────────────────────────────
# 授权商店 —— 支付
# ─────────────────────────────────────────────────────────────────────

# mock：内置模拟收银台（默认，本地联调）；alipay：真实支付宝。
# 后台「站点配置」里的支付渠道优先于这里。
#STORE_PAYMENT_PROVIDER=mock

# 支付宝接入参数。私钥/公钥可以用「内联文本」或「文件路径」两种方式之一。
# 除 _APP_PRIVATE_KEY / _PUBLIC_KEY 外都能在后台「站点配置 → 支付」里改（免重启，
# 留空跟随环境变量）；后台改完可点「测试凭据」。回调地址不能填 localhost/内网，
# 否则支付宝根本访问不到，订单会一直停在「待支付」。
#STORE_ALIPAY_APP_ID=
#STORE_ALIPAY_SELLER_ID=
#STORE_ALIPAY_SIGN_TYPE=RSA2
#STORE_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
#STORE_ALIPAY_APP_PRIVATE_KEY=
#STORE_ALIPAY_APP_PRIVATE_KEY_PATH=
#STORE_ALIPAY_PUBLIC_KEY=
#STORE_ALIPAY_PUBLIC_KEY_PATH=
#STORE_ALIPAY_NOTIFY_URL=
#STORE_ALIPAY_RETURN_URL=
#STORE_ALIPAY_TRANSACTION_DESCRIPTION=
# 是否校验支付宝异步通知的签名。生产不要关。
#STORE_ALIPAY_VERIFY_RESPONSE=true


# ─────────────────────────────────────────────────────────────────────
# 授权商店 —— seed 初始化管理员
# ─────────────────────────────────────────────────────────────────────
#
# 仅在 `python -m store.tools.seed` 时使用：不设置就会用代码内置的开发默认值
# （并打印警告）。生产部署务必覆盖，且确认 store/data/store.db 里没有残留默认管理员。

#STORE_ADMIN_EMAIL=admin@example.com
#STORE_ADMIN_PASSWORD=
