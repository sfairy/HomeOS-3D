# HomeOS 环境变量模板
#
#   cp .env.example .env
#
# 全部默认注释掉，复制不改也能启动。优先级：真实环境变量 > .env > 代码默认值。
# 布尔取值：1 / on / yes / true（含空格或 # 请加引号）。
# 站点名 / 公告 / 客服 / 维护 / SMTP / 支付渠道 等请到商店 /admin「站点配置」改（免重启）。
#
# 部署地址速查（本仓库当前取值）：
#   主应用  http://<IP>:8801 · https://<IP>:8803（自签） · https://homelife.iepose.cn（穿透）
#   商店    http://<IP>:8802 · https://homelifepay.iepose.cn（穿透，无内网 HTTPS）


# ── A. 部署常改（地址 / 反代 / Cookie）────────────────────────────────

# 生产标记。镜像已内置 production；只在覆盖时写（production / prod 视为生产）。
#APP_ENVIRONMENT=production
# 授权门禁显式开关（优先级高于环境标记）。0 = 排障时临时关闭，别在客户机长期置 0。
#LICENSE_REQUIRED=1

# 主应用对外地址 = 浏览器实际用的那个来源（scheme://host[:port]，不带路径）。
# 反代 / 穿透必须填公网域名：同源校验、WebSocket 来源、socket.io 白名单都按它；
# 留空会「面板一直重连 + 登录类写操作 403」。填了之后局域网 IP 直连仍然可用。
#APP_BASE_URL=https://homelife.iepose.cn

# 主应用出站访问的商店地址（取公钥 / 激活 / 心跳 / 代发验证码）。
# 客户机填公网域名；同机部署走 compose 服务名 http://homeos-store:8802（已写死）。
# 留空会让容器启动即退出。
#APP_LICENSE_SERVER_URL=https://homelifepay.iepose.cn
# 只有商店在同一可信局域网时才用明文直连（内网不提供商店 HTTPS）：
#APP_LICENSE_SERVER_URL=http://192.168.1.20:8802

# 浏览器打开的商店地址（登录页「忘记密码 / 商店」）。留空会向商店询问，但商店不可达时
# 前端兜底成 127.0.0.1:8802，所以公网部署建议写死，并与 STORE_BASE_URL 同域。
#APP_STORE_URL=https://homelifepay.iepose.cn

# 可信代理网段：回环 = 容器内 Caddy；docker 网段 = 宿主 / 容器里的反代、隧道。
# 两行同口径（前者管应用解析客户端 IP，后者管 uvicorn）。绝不填 *。
#APP_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
#UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12

# Cookie 的 Secure：auto 按本次请求实际协议判定（双入口部署必须用它）；
# true / false 只适合单一协议。依赖入口透传 X-Forwarded-Proto；
# 漏传只是少一层 Secure，不会登录失败。
#COOKIE_SECURE=auto

# 内置 HTTPS(8803) 的证书签给谁。用 IP 访问时必须填该 IP（IP 不带 SNI，否则证书不匹配）。
# 只填名字，不带协议 / 端口。商店没有任何 HTTPS 入口，因此没有对应变量。
#APP_HTTPS_DEFAULT_SNI=192.168.1.10

# 商店对外身份：支付回调、同源判定、商店链接都按它推导。必须是公网域名，不是 8802。
#STORE_BASE_URL=https://homelifepay.iepose.cn
# 商店 Cookie 的 Secure，口径同 COOKIE_SECURE（公网 https 带、内网 http 不带）。
#STORE_COOKIE_SECURE=auto
# 商店可信代理（回环 + 入口网段）。商店 uvicorn 不读 UVICORN_FORWARDED_ALLOW_IPS。
#STORE_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12


# ── B. 主应用：路径 / 会话 / 授权（默认即可）───────────────────────────

#HOMEOS_DATA_DIR=./homeos/data          # 数据目录（镜像固定 /data）
#HOMEOS_BACKUPS_DIR=                    # 备份包目录（镜像 /data/backups）
#HOMEOS_PORT=8801                       # HTTP 端口；镜像入口读 APP_PORT，两者保持一致
#APP_PORT=8801
#HOMEOS_FRONTEND_DIR=                   # 前端产物（镜像 /app/dist）
#HOMEOS_IMAGE_DIR=                      # 内置素材（镜像 /app/image）
#HOMEOS_ASSETS_DIR=                     # 可替换 UI 素材（镜像 /app/assets，compose 挂宿主 ./assets）

# 会话与 Cookie 名
#JWT_EXPIRES_IN_SECONDS=86400
#COOKIE_NAME=auth_token
#CSRF_COOKIE_NAME=csrf_token
#CSRF_HEADER_NAME=X-CSRF-Token

#APP_HA_REQUEST_TIMEOUT_SECONDS=10
#APP_HA_RECONCILE_INTERVAL_SECONDS=1800
#APP_HA_WEBSOCKET_MAX_SIZE_BYTES=67108864
#APP_LICENSE_REQUEST_TIMEOUT_SECONDS=10
#APP_LICENSE_SERVER_BATCHES=esa=;eo=;direct=http://127.0.0.1:8802

# 授权公钥：目录可写则启动时向商店 GET /v2/keys 取回并缓存，之后可离线启动；
# 同机部署改挂共享只读卷（compose 里 APP_CLIENT_KEYS_DIR=/shared-keys）；off 关掉自动取回。
#APP_CLIENT_KEYS_DIR=/data/client-keys
#APP_CLIENT_KEYS_FETCH=auto
# keyId 默认由公钥字节派生，一般不用设；显式设置后轮换时两侧必须同步改。
#APP_LICENSE_KEY_ID=
#APP_LICENSE_PUBLIC_KEY_FILE=keys/license-public.pem
#APP_LICENSE_TRANSPORT_KEY_ID=
#APP_LICENSE_TRANSPORT_PUBLIC_KEY_FILE=keys/license-transport-public.pem
#APP_HA_CREDENTIAL_FILE=/run/secrets/ha_credentials.key
#APP_LICENSE_CREDENTIAL_FILE=/run/secrets/license_credentials.key

# 授权实例指纹：留空 = 由宿主 machine-id / DMI 派生。
# 显式填 = 钉住身份（防容器重建漂移、跨机迁移）；改动等价于换设备，需先解绑。
#APP_HARDWARE_MACHINE_ID=
#APP_HARDWARE_BOARD_ID=

# 一般不用设：
#   APP_SETUP_TOKEN                 首启自动生成并写入 data/setup-token
#   APP_LICENSE_*_SHA256            启动器按实际公钥实算
#   APP_LICENSE_TRUSTED_PUBLIC_KEYS 仅密钥轮换时需要
#   LOG_HTTP_ACCESS                 errors(默认) / all / off
#   LOG_STATUS_DEDUPE_MS            重复日志折叠窗口，默认 1800000


# ── C. 商店基础设施（后台改不了；严格解析，写错拒绝启动）────────────────

#STORE_HOST=0.0.0.0
#STORE_PORT=8802
#STORE_DATA_DIR=./homeos-store/data
#STORE_LICENSE_KEYS_DIR=./homeos-store/keys/local
# 新建站点的默认客服邮箱（已有站点以 /admin 里的值为准）。
#STORE_SUPPORT_EMAIL=support@your-domain.com
# keyId 默认留空（由公钥字节派生）；只有老部署联调才需要钉住。
#STORE_LICENSE_KEY_ID=
#STORE_LICENSE_TRANSPORT_KEY_ID=

# 租约有效期：同时决定「客户端离线可用多久」与「吊销生效上界」。
# 超时且拿不到新租约时客户机直接进入 LEASE_EXPIRED，面板被授权门禁挡住（整机不可用，不是降级）。
# 内网穿透部署要**按隧道最长可中断时长**取值：3 天太短的话（例如家里断网一周），
# 改成 2592000（30 天），代价是吊销在客户机上生效同样变慢。
#STORE_LEASE_TTL_SECONDS=259200
#STORE_HEARTBEAT_INTERVAL_SECONDS=300
# /v2/heartbeat、/v2/recover 的来源 IP 小时配额（多设备共用 NAT 出口时调大）。
#STORE_LICENSE_SESSION_IP_HOURLY_LIMIT=3600
# 待支付订单有效期。真实收款必须调大（支付宝二维码活约 2 小时），建议 600~1800。
#STORE_ORDER_TTL_SECONDS=900

#STORE_SESSION_MAX_AGE_SECONDS=2592000
#STORE_COOKIE_NAME=homeos_store_session
#STORE_PAYMENT_SWEEP_INTERVAL_SECONDS=30
#STORE_PAYMENT_SWEEP_BATCH=25

# 验证码投递：log(默认，只写容器日志) / smtp。公开售卖前务必配好 SMTP 并发测试邮件，
# 否则客户收不到验证码。发件域记得配 SPF / DKIM。
#STORE_MAIL_MODE=smtp
#STORE_MAIL_FROM=HomeOS <no-reply@your-domain.com>
#STORE_SMTP_HOST=smtp.exmail.qq.com
#STORE_SMTP_PORT=465
#STORE_SMTP_USERNAME=
#STORE_SMTP_PASSWORD=
#STORE_SMTP_USE_SSL=true
#STORE_SMTP_STARTTLS=false

# 全站验证码小时上限（超出后所有人都收不到，日志会提示调高）。
#STORE_VERIFICATION_GLOBAL_HOURLY_LIMIT=500
# 访问日志详略：errors(默认) / all / off
#STORE_LOG_HTTP_ACCESS=errors
# 重复日志折叠窗口（毫秒）；支付与巡检异常永不折叠。
#STORE_LOG_STATUS_DEDUPE_MS=1800000


# ── D. 支付宝（可选；需企业 / 个体工商户主体）──────────────────────────
#
# 也可在 /admin「站点配置 → 支付渠道」填（DB 值优先）。留空 = 未配置 → 拒绝建单
# （fail-closed，不会回落到免费通道）。下单前还要签约「当面付」并配好密钥。

#STORE_PAYMENT_PROVIDER=alipay
#STORE_ALIPAY_APP_ID=
# 收款账号 uid：配了就核验回调里的 seller_id，防止别人往你的回调推消息。
#STORE_ALIPAY_SELLER_ID=

# 密钥推荐挂文件（PEM 多行）；内联值也可，文件优先。
#STORE_ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private.pem
#STORE_ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public.pem
#STORE_ALIPAY_APP_PRIVATE_KEY=
# 这里填开放平台下载的「支付宝公钥」，不是你上传的应用公钥（填反 = 验签全失败）。
#STORE_ALIPAY_PUBLIC_KEY=

#STORE_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# 回调地址：不填按 STORE_BASE_URL 推导；填了必须公网可达（内网地址保存即拒）。
#STORE_ALIPAY_NOTIFY_URL=https://homelifepay.iepose.cn/store/v1/payments/alipay/notify
#STORE_ALIPAY_RETURN_URL=https://homelifepay.iepose.cn/store/payment/return
#STORE_ALIPAY_TRANSACTION_DESCRIPTION=HomeOS 授权

# 非排障不要动：本服务只实现 RSA2；关掉响应验签等于放弃真实性校验。
#STORE_ALIPAY_SIGN_TYPE=RSA2
#STORE_ALIPAY_VERIFY_RESPONSE=true


# ── E. 微信支付（可选；需开通 Native 支付）──────────────────────────────
#
# 四件套缺一不可：mchid + appid、商户私钥、证书序列号、微信支付公钥；
# 另需 APIv3 密钥（32 字符）解密回调。公钥验签 + 密钥解密都成功才算可信通知。
# 通道启用仍由 /admin 决定；STORE_PAYMENT_PROVIDER 只是后台没勾时的默认值。

#STORE_WECHAT_MCH_ID=
#STORE_WECHAT_APP_ID=
#STORE_WECHAT_MERCHANT_SERIAL_NO=
#STORE_WECHAT_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/wechat_apiclient_key.pem
#STORE_WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public_key.pem
#STORE_WECHAT_API_V3_KEY=
#STORE_WECHAT_PLATFORM_PUBLIC_KEY_ID=

# 回调地址：不填按 STORE_BASE_URL 推导；填了必须公网可达。
#STORE_WECHAT_NOTIFY_URL=https://homelifepay.iepose.cn/store/v1/payments/wechat/notify
#STORE_WECHAT_TRANSACTION_DESCRIPTION=HomeOS 授权
#STORE_WECHAT_GATEWAY_URL=https://api.mch.weixin.qq.com

# 内联写法：STORE_WECHAT_MERCHANT_PRIVATE_KEY / STORE_WECHAT_PLATFORM_PUBLIC_KEY
# （PEM 全文，换行用 \n）。


# ── F. 账号 ──────────────────────────────────────────────────────────
#
# 主应用首装零用户：打开任何地址都会跳 /register 注册本机唯一账号（邮箱验证码由商店
# 代发，所以商店必须可达且配好 SMTP）。清空数据卷即回到可重新注册的状态。
# 商店管理员用引导密钥在 /setup 创建：
#   docker logs homeos-store 2>&1 | grep -m1 SETUP-TOKEN=


# ── G. 构建 / 镜像 / 公网入口（compose 已写死常用值）────────────────────

# 版本真源是根 package.json；compose 里写的是 :latest，钉版请改 image: 行。
#HOMEOS_VERSION=0.7.6
#HOMEOS_IMAGE=ghcr.io/sfairy/homeos:0.7.6
#HOMEOS_STORE_IMAGE=ghcr.io/sfairy/homeos-store:0.7.6
# 基础镜像镜像站（仅本地构建；用它会丢掉 Dockerfile 的 @sha256 钉版，正式产物走 CI）。
#HOMEOS_BASE_MIRROR=docker.m.daocloud.io

# 仅在改了 compose 的宿主端口时才需要设（否则按请求 Host 推导）：
#APP_PUBLISH_PORT=8801
#STORE_PUBLISH_PORT=8802
#APP_PROXY_PUBLISH_PORT=8803

# 公网入口（详见 ops/deploy/PUBLIC-ACCESS.md 与 TUNNEL-ACCESS.md）：
#   • 隧道 / 反代回灌到 127.0.0.1:8801（主应用）、127.0.0.1:8802（商店）；
#     不要指到 8803 —— 那是自签证书，客户机与支付平台都不认（商店没有 HTTPS 端口）。
#   • 入口必须透传 Host、X-Forwarded-Proto: https、X-Real-IP / X-Forwarded-For，
#     允许 WebSocket 升级，client_max_body_size ≥ 16m。
#   • 8801 / 8802 / 8803 不对公网放行（Docker 映射绕过 ufw，用云安全组收敛）。
#   取消注释 docker-compose.yml 的 caddy-public 段时填：
#STORE_DOMAIN=homelifepay.iepose.cn
#ACME_EMAIL=you@example.com
