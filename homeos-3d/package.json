{
  "name": "homeos-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:runtime": "vite build --config frontend/vite.runtime.config.ts --watch",
    "build:app": "vite build --config frontend/vite.config.ts",
    "build:runtime": "vite build --config frontend/vite.runtime.config.ts",
    "build": "bun run build:app && bun run build:runtime",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
