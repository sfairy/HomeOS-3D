{
  "name": "homeos-3d-067-ts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:runtime": "vite build --config frontend/vite.runtime.config.ts --watch",
    "build:app": "vite build --config frontend/vite.config.ts",
    "build:runtime": "vite build --config frontend/vite.runtime.config.ts",
    "build": "bun run build:app && bun run build:runtime",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "verify:material": "bun tools/verify_model_material_roles.ts",
    "verify:parity": "python3 tools/verify_parity.py",
    "verify:smoke": "../.venv-store/bin/python tools/smoke_pages.py",
    "verify": "bun run typecheck && bun run verify:material && bun run build && bun run verify:parity && bun run verify:smoke"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
