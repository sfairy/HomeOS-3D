{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowUnreachableCode": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@app/*": ["./frontend/src/app/*"],
      "@runtime/*": ["./frontend/src/runtime/*"],
      "three": ["./frontend/src/shims/vendor-three-core.ts"],

      "/static/vendor/three/0.186.0/three.module.min.js": [
        "./frontend/src/shims/vendor-three-core.ts"
      ],
      "/static/vendor/three/0.186.0/OrbitControls.js": [
        "./frontend/src/shims/vendor-three-addons.ts"
      ],
      "/static/vendor/three/0.186.0/RoundedBoxGeometry.js": [
        "./frontend/src/shims/vendor-three-addons.ts"
      ],
      "/static/vendor/three/0.186.0/BufferGeometryUtils.js": [
        "./frontend/src/shims/vendor-three-addons.ts"
      ],
      "/static/vendor/three/0.186.0/GLTFLoader.js": [
        "./frontend/src/shims/vendor-three-addons.ts"
      ],
      "/static/vendor/three/0.186.0/DRACOLoader.js": ["./frontend/src/shims/draco-loader.ts"],
      "/static/vendor/qrcode-generator/qrcode.js": ["./frontend/src/shims/qrcode.ts"],
      "/static/vendor/meshoptimizer/0.25/meshopt_simplifier.module.js": [
        "./frontend/src/shims/meshopt.ts"
      ],

      "/api/v1/modules/interaction3d/core/runtime.js": [
        "./frontend/src/shims/interaction3d-runtime.ts"
      ],
      "/api/v1/modules/interaction3d/core/stage.js": [
        "./frontend/src/shims/interaction3d-stage.ts"
      ],
      "/api/v1/modules/interaction3d/editor/config-editor.js": [
        "./frontend/src/shims/interaction3d-config-editor.ts"
      ],
      "/api/v1/modules/interaction3d/security/security-editor.js": [
        "./frontend/src/shims/interaction3d-security-editor.ts"
      ]
    }
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.d.ts",
    "frontend/vite.config.ts",
    "frontend/vite.runtime.config.ts",
    "frontend/vite-quiet-logger.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
