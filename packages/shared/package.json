{
  "name": "@homeos/shared",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./components/PasswordField.vue": "./src/components/PasswordField.vue",
    "./components/SceneStage.vue": "./src/components/SceneStage.vue",
    "./scene/scene-values": "./src/scene/scene-values.ts",
    "./scene/touch-profile": "./src/scene/touch-profile.ts",
    "./utils/clipboard": "./src/utils/clipboard.ts"
  },
  "scripts": {
    "sync:scene": "bun scripts/sync-scene-static.mjs",
    "build": "bun run sync:scene && tsc -p tsconfig.esm.json && bun scripts/build-cjs.mjs",
    "lint": "eslint \"**/*.{ts,vue}\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
