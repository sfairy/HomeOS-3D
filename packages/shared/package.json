{
  "name": "@homeos/shared",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./components/PasswordField.vue": "./src/components/PasswordField.vue",
    "./components/SceneStage.vue": "./src/components/SceneStage.vue",
    "./components/EntryShell.vue": "./src/components/EntryShell.vue",
  "./components/entry-step": "./src/components/entry-step.ts",
  "./notification/voice-alert": "./src/notification/voice-alert.ts",
  "./scene/scene-values": "./src/scene/scene-values.ts",
    "./scene/touch-profile": "./src/scene/touch-profile.ts",
    "./security/password-policy": "./src/security/password-policy.ts",
    "./utils/clipboard": "./src/utils/clipboard.ts"
  },
  "scripts": {
    "sync:scene": "bun scripts/sync-scene-static.mjs",
    "check:scene": "bun scripts/sync-scene-static.mjs --check",
    "build": "bun run sync:scene && tsc -p tsconfig.esm.json && bun scripts/build-cjs.mjs",
    "lint": "bun run --cwd ../.. lint && node ../../ops/lib/check-css-syntax.mjs scene/static",
    "check:css": "node ../../ops/lib/check-css-syntax.mjs scene/static",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
