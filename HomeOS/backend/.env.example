NODE_ENV=development
PORT=8501
# 本地开发（PostgreSQL；密码须与 bun run dev:db 生成的 ./secrets/postgres_password 一致，
# 或与仓库根 .env / 环境变量 POSTGRES_PASSWORD 一致）
# 本机 bun run 请用 localhost / 127.0.0.1；勿写 Docker 服务名 postgres（仅 Compose 容器网络可解析）
# 若希望固定示例口令，首次 bun run dev:db 前在仓库根 .env 写 POSTGRES_PASSWORD=homeos-local-dev
DATABASE_URL=postgresql://homeos:homeos-local-dev@localhost:5432/homeos
# 容器部署（连接池由 PrismaService / adapter-pg 读取下列变量，勿再写 URL ?connection_limit=）
# DATABASE_URL=postgresql://homeos:${POSTGRES_PASSWORD}@postgres:5432/homeos
# 默认 10，对齐 Compose 中 Postgres 512m；本机大库可调高
# PRISMA_CONNECTION_LIMIT=10
# PRISMA_POOL_TIMEOUT=30
# PRISMA_CONNECT_TIMEOUT=10
# 数据库连接失败重试（启动时 AppConfig 尚未加载，仅能通过环境变量配置）
# PRISMA_MAX_RETRIES=3
# PRISMA_RETRY_DELAY_MS=2000
# 生产环境拒绝过弱 / 演示默认密码（Compose 默认 1；本机 production 连已有演示库设 0）
# HOMEOS_HARDENED=1
# Redis：本地 bun run dev:db 映射后用 localhost，密码须与 ./secrets/redis_password 或 REDIS_PASSWORD 一致
REDIS_URL=redis://:homeos-local-dev@localhost:6379
# Docker Compose 全栈部署
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
# JWT 密钥；生产 Docker 未设置时自动写入 data/.jwt-secret
JWT_SECRET=REPLACE_ME_run_openssl_rand_hex_32_before_deploy
# 访客临时密码加密密钥；未设置时自动写入 data/.guest-pass-secret
# GUEST_PASS_SECRET=
# JWT / WebSocket 会话有效期（HTTP Cookie 与 Socket.IO 共用；墙屏常亮建议 365d）
# JWT_EXPIRES_IN=30d
# Socket.IO 单帧缓冲上限 MB（8~50，大型 HA 实例可适当调高）
# WS_PUSH_MAX_BUFFER_MB=32
# Cookie Secure：auto=按请求协议自动（HTTP :8126 非 Secure，HTTPS :8443 Secure）；开发可省略
# COOKIE_SECURE=auto
# CORS 允许的来源，逗号分隔；留空则仅放行同源、localhost 与局域网(RFC1918)
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:8501
# Home Assistant（数据库 layout.haConfig 未配置时作为回退；Docker 须用容器可达地址）
# HA_URL=http://host.docker.internal:8123
# HA_URL_FALLBACK=https://ha.example.com
# HA_TOKEN=your-long-lived-access-token
# 平面图资源目录（可选，默认 assets/floorplans）
# FLOORPLANS_DIR=/app/floorplans
# 仪表盘背景图目录（可选，默认 assets/backgrounds）
# BACKGROUNDS_DIR=/app/backgrounds
# 图标 SVG 目录（可选，默认 assets/icons）
# ICONS_DIR=/app/icons
# 竖屏房间背景图目录（可选，默认 assets/room_images）
# ROOM_IMAGES_DIR=/app/room_images
# 品牌 Logo 目录（可选，默认 assets/logo；文件 logo.svg → /logo/logo.svg）
# LOGO_DIR=/app/logo
# 音效目录（可选，默认 assets/sounds）
# SOUNDS_DIR=/app/sounds
# Prometheus /metrics：生产外网访问需设置；未设置时仅本机回环可探活（便于本地验收）
# METRICS_TOKEN=
# 事件日志保留天数（AppConfig 优先，此为 fallback）
# EVENTLOG_RETENTION_DAYS=7
# 状态类日志去重窗口（毫秒）：相同 context+消息在窗口内只输出一次；0=关闭；默认 300000（5 分钟）
# LOG_STATUS_DEDUPE_MS=300000
# 日志格式：json=结构化 JSON 行；默认人类可读
# LOG_FORMAT=json
# 通知为家庭局域网站内（应用内 + Socket 实时 + TTS 播报），无外网推送渠道

# ── 商业授权（离线永久）──
# 本机 NODE_ENV=production 时建议显式关闭门禁；Compose/生产镜像默认 LICENSE_REQUIRED=1
LICENSE_REQUIRED=0
# 授权目录（默认 monorepo 根 ./license，内写 license.jwt）
# LICENSE_DIR=
# LICENSE_FILE=
# 验签公钥（PEM）；不设则用构建内嵌公钥
# LICENSE_PUBLIC_KEY=
# LICENSE_PUBLIC_KEY_PATH=
# 仅非 production 可用的开发绕过；production 设置将导致进程拒绝启动
# HOMEOS_LICENSE_BYPASS=
# MCP JSON-RPC 网关密钥（Header: x-homeos-mcp-key）；也可在 UI agentConfig.mcpGatewaySecret 配置
# MCP_GATEWAY_SECRET=
