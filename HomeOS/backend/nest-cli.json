{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "exec": "bun",
  "compilerOptions": {
    "allowOutsidePaths": true,
    "builder": {
      "type": "swc",
      "options": {
        "outDir": "../dist/backend",
        "stripLeadingPaths": true
      }
    },
    "assets": [
      {
        "include": "generated/**/*",
        "watchAssets": true
      }
    ],
    "typeCheck": false,
    "deleteOutDir": false
  }
}
