{
  "compilerOptions": {
    "target": "ES2022",

    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "module": "ESNext",

    "moduleResolution": "bundler",

    "strict": true,

    "noImplicitAny": true,

    "strictNullChecks": true,

    "noEmit": true,

    "allowJs": false,

    "checkJs": false,

    "skipLibCheck": true,

    "isolatedModules": true,

    "jsx": "preserve",

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },

  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/env.d.ts"],

  "exclude": ["node_modules", "dist"]
}
