{
  "version": 2,
  "updatedAt": "2026-09-30T08:05:00+08:00",
  "note": "The controlled vocabulary for the second frontend rename wave (see frontend/NAMING.md section 2.5). A rename map is only allowed to introduce a name that is either a 'canonical' here, a 'canonical' with only the morphological transforms listed in tools/lib/name-buckets.mjs T1-T8, or an entry registered as an exception with an approver.  The point is not this list being exhaustive: it is that two batches working in different files cannot invent two different names for one concept, which is what produced threeNamespace/threeCore/threeToolkit/threeContext for the same argument.",
  "domains": [
    "ha",
    "scene",
    "dom",
    "net",
    "cache",
    "time",
    "persist",
    "misc"
  ],
  "transforms": {
    "T1": "plural in -s, only where the value is an Array literal, Array.from/map/filter/split, or [...spread]",
    "T2": "*By<Key>, only where the value is new Map()/new WeakMap()",
    "T3": "*Set, only where the value is new Set()/new WeakSet()",
    "T4": "boolean prefix is/has/should/can, only where every assignment is a comparison, negation, logical op, includes/startsWith, or a predicate call",
    "T5": "pipeline prefix raw/normalized/parsed/serialized/cached/previous/next/pending (parsed* must come from JSON.parse, *Json must be a string)",
    "T6": "unit suffix Ms/Px/Rad/Deg/Ratio/Count/Index, only where the value is numeric; *Ms initialiser may not contain '* 1000'; *Ratio is in [0,1]",
    "T7": "<owner><Canonical>, only when the canonical is already taken in the same file; owner must be a domain word",
    "T8": "callback on* when supplied by the caller, handle* when implemented in this file"
  },
  "compoundLimit": 2,
  "disambiguation": "T7 is the only permitted way to resolve a collision; a numeric suffix is never allowed",
  "aliasTokens": {
    "core": "namespace",
    "toolkit": "namespace",
    "ctx": "context",
    "ns": "namespace",
    "lib": "namespace"
  },
