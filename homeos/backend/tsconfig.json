{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "sourceMap": false,
    "outDir": "../dist/backend",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.nest-build/tsconfig.tsbuildinfo",
    "paths": {
      "@generated/prisma": ["./src/generated/prisma/client"],
      "@generated/prisma/*": ["./src/generated/prisma/*"]
    },
    "types": ["node"],
    "incremental": true,
    "skipLibCheck": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/generated"]
}
