# HomeOS 后端环境变量示例。
#
# 复制为 backend/.env 后按需修改（backend/.env 已被 .gitignore 忽略）。
# 加载顺序：backend/.env → 仓库根 .env；已存在的环境变量优先（不覆盖容器 / 编排注入值）。

# 必填：JWT 签名密钥，同时派生访客临时密码密钥。生产环境务必使用高强度随机值。
JWT_SECRET=

# 可选：访客临时密码专用密钥；留空则回退 JWT_SECRET。
GUEST_PASS_SECRET=

# 可选：会话有效期（秒），默认 86400（24 小时）。
JWT_EXPIRES_IN_SECONDS=86400

# ---- 服务端 TTS（对话语音播报）----
# 引擎：edge（微软 Edge 朗读，默认）或 openai（任意 OpenAI 兼容 /audio/speech）。
# AGENT_TTS_ENGINE=edge
#
# 走代理访问 wss://speech.platform.bing.com。留空时沿用标准代理变量
# （HTTPS_PROXY / ALL_PROXY）。跨境链路握手偶发卡死时可在这里钉住本机代理：
# AGENT_TTS_EDGE_PROXY=http://127.0.0.1:33211
#
# 上游端点与令牌版本一般不用改，只有微软调整服务端时才需要覆盖：
# AGENT_TTS_EDGE_ENDPOINT=
# AGENT_TTS_EDGE_GEC_VERSION=
