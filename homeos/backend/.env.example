# HomeOS 后端环境变量示例。
#
# 复制为 backend/.env 后按需修改（backend/.env 已被 .gitignore 忽略）。
# 加载顺序：backend/.env → 仓库根 .env；已存在的环境变量优先（不覆盖容器 / 编排注入值）。

# 必填：JWT 签名密钥，同时派生访客临时密码密钥。生产环境务必使用高强度随机值。
JWT_SECRET=

# 可选：访客临时密码专用密钥；留空则回退 JWT_SECRET。
GUEST_PASS_SECRET=

# 可选：Redis（多副本 / 跨进程事件总线）；留空则仅进程内通信。
REDIS_URL=

# 可选：会话有效期（秒），默认 28800。
JWT_EXPIRES_IN_SECONDS=28800
