{
  "name": "homeos",
  "private": true,
  "version": "0.7.2",
  "description": "HomeOS 智能家居中央控制平台 — Home Assistant 上层 UI 网关，提供 Dashboard、户型图可视化、设备触控、安防、能源管理与语音交互",
  "scripts": {
    "bump": "bun scripts/bump-version.mjs",
    "clean:local": "bun scripts/clean-local.mjs",
    "prep": "bun scripts/run.mjs prep",
    "build:shared": "bun run --cwd packages/shared build",
    "dev": "bun scripts/dev.mjs",
    "dev:backend": "cd backend && HOMEOS_RELOAD=1 .venv/bin/python -m src.run",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:runtime": "bun run --cwd frontend dev:runtime",
    "build": "bun scripts/run.mjs build",
    "build:frontend": "bun scripts/run.mjs build:frontend",
    "start:prod": "sh deploy/run-backend.sh python",
    "lint": "bun scripts/run.mjs lint",
    "typecheck": "bun scripts/run.mjs typecheck",
  "typecheck:py": "bun scripts/run.mjs typecheck:py",
    "check": "bun scripts/run.mjs check"
  }
}
