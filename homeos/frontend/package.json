{
  "name": "homeos-dashboard",
  "private": true,
  "version": "0.7.1",
  "description": "HomeOS 前端中控界面（Vue）— 墙面平板优先的智能家居 Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "vite --force",
    "build": "vite build && vite build --config vite.runtime.config.ts",
    "build:app": "vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "dev:runtime": "vite build --config vite.runtime.config.ts --watch",
    "build:analyze": "set ANALYZE=1&& vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:ci": "eslint \"src/**/*.{ts,vue}\" --max-warnings 0",
    "check:studio-deps": "node scripts/check-studio-deps.mjs",
    "check:frontend-deps": "node scripts/check-frontend-deps.mjs",
    "check:deps": "node scripts/check-frontend-deps.mjs && node scripts/check-studio-deps.mjs",
    "typecheck": "node scripts/run-vue-tsc.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@homeos/shared": "workspace:*",
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "hls.js": "^1.7.3",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2",
    "three": "0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "0.186.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
