{
  "name": "homeos-dashboard",
  "private": true,
  "version": "0.8.6",
  "description": "HomeOS 前端中控界面（Vue）— 墙面平板优先的智能家居 Dashboard",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/shared sync:scene && vite",
    "dev:clean": "bun run --cwd ../../packages/shared sync:scene && vite --force",
    "build": "bun run --cwd ../../packages/shared sync:scene && vite build && vite build --config vite.runtime.config.ts",
    "build:app": "bun run --cwd ../../packages/shared sync:scene && vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "dev:runtime": "vite build --config vite.runtime.config.ts --watch",
    "build:analyze": "bun run --cwd ../../packages/shared sync:scene && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "bun run --cwd ../.. lint",
    "lint:ci": "bun run --cwd ../.. lint && node ../../ops/lib/check-css-syntax.mjs",
    "check:deps": "node ../../ops/checks/frontend/check_frontend_deps.mjs",
    "check:css": "node ../../ops/lib/check-css-syntax.mjs",
    "typecheck": "node ../../ops/lib/run-vue-tsc.mjs -p tsconfig.json --noEmit",
    "sync:three": "node scripts/build-three-vendor.mjs",
    "sync:three:check": "node scripts/build-three-vendor.mjs --check",
    "sync:hls": "node scripts/sync-hls-vendor.mjs",
    "sync:hls:check": "node scripts/sync-hls-vendor.mjs --check"
  },
  "dependencies": {
    "@homeos/shared": "workspace:*",
    "@lucide/vue": "^1.69.0",
    "axios": "^1.21.0",
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "hls.js": "^1.7.4",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2",
    "three": "0.187.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
