# HomeOS 授权商店 —— 镜像内置的内网 HTTPS 反代（Caddy 内置 CA，按需自签证书）
#
# 由 ops/docker/start_store.py 在容器内与商店同容器拉起：监听 :8804，
# 反代到同容器的 127.0.0.1:8802。因为反代就在应用旁边：
#   - 不要求把 8802 先发布到宿主机；
#   - uvicorn 的转发头信任范围保持默认回环（127.0.0.1,::1）即可，无需放宽到 docker 网段。
# Dockerfile 会在构建时把本文件复制为 /etc/caddy/Caddyfile。
#
#   - 裸 :8804 站点 + tls internal { on_demand }：证书按连入的 SNI 动态签发 —— 用**主机名**
#     访问（例如 https://store.local:8804）天然就对得上；
#   - HTTP 备用：继续直连容器发布的 8802，不经本反代；
#   - WebSocket 由 Caddy v2 reverse_proxy 默认自动升级。
#
# ── default_sni 为什么必须有（别删）─────────────────────────────────────────────
#
# 完整说明见 ops/caddy/app.Caddyfile 的同名注释（主应用那份写得更细）。一句话：
# 浏览器访问 **IP 字面量**时不发 SNI，on_demand 就只能按容器自己的 docker IP 签证书
# （实测 SAN = IP:172.19.0.2），浏览器判「证书与地址不匹配」，https://<局域网IP>:8804
# 打不开。default_sni 是给这类连接的兜底名字，由 STORE_HTTPS_DEFAULT_SNI 注入。
#
# 公网接入（真实域名 + 可信证书）走的是 ops/deploy/Caddyfile.public.example，不是这里。
{
	skip_install_trust
	admin off
	auto_https disable_redirects
	default_sni {$STORE_HTTPS_DEFAULT_SNI:store.local}
	# 控制台只打错误；证书维护 / GOMAXPROCS 等 info 刷屏关掉
	log {
		level ERROR
		format console
	}
	# h1 支持 WebSocket 升级，h2 用于常规 HTTP/2
	servers :8804 {
		protocols h1 h2
	}
}

# 裸 :8804 匹配任意主机名 / IP；IP 直连（无 SNI）由上面的 default_sni 兜住
:8804 {
	tls internal {
		on_demand
	}

	reverse_proxy 127.0.0.1:8802 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
