# HomeOS 主应用 —— 镜像内置的内网 HTTPS 反代（Caddy 内置 CA，按需自签证书）
#
# 由 ops/docker/start_app.py 在容器内与 uvicorn 同容器拉起：监听 :8803，
# 反代到同容器的 127.0.0.1:${APP_PORT:-8801}。因为反代就在应用旁边：
#   - 不要求把 8801 先发布到宿主机；
#   - 这条内置反代的对端永远是回环，uvicorn 信任 127.0.0.1,::1 就够。compose 里之所以还写了
#     docker 网段（APP_TRUSTED_PROXIES / UVICORN_FORWARDED_ALLOW_IPS 含 172.16.0.0/12），
#     是为了**另一条**链路：内网穿透 / 宿主反代回灌到已发布的 8801 时，容器看到的源是网桥
#     网关 172.x。两者互不影响。
# Dockerfile 会在构建时把本文件复制为 /etc/caddy/Caddyfile。
#
#   - 裸 :8803 站点 + tls internal { on_demand }：证书按连入的 SNI 动态签发 —— 用**主机名**
#     访问（例如 https://homeos.local:8803）天然就对得上；
#   - HTTP 备用：继续直连容器发布的 8801，不经本反代；
#   - WebSocket 由 Caddy v2 reverse_proxy 默认自动升级。
#
# ── default_sni 为什么必须有（别删）─────────────────────────────────────────────
#
# 浏览器访问 **IP 字面量**时**不发 SNI**（RFC 6066：SNI 只能是主机名，IP 不算）。这样
# on_demand 拿不到任何名字，只能按「本机地址」签发 —— 那是容器自己的 docker IP
# （实测证书 SAN = IP:172.19.0.3），于是浏览器判「证书与地址不匹配」：
# https://<局域网IP>:8803 打不开，部分 WebView / PWA 安装还会硬拦（连「继续前往」都没有）。
#
# default_sni 就是给「没有 SNI 的连接」兜底的那个名字：把它设成你实际输入的那个地址
# （一般就是局域网 IP），证书才会签给这个地址、浏览器才只报「不受信任的 CA」这一步。
# 取值来自 APP_HTTPS_DEFAULT_SNI（compose 注入，见 docker-compose.yml / .env.example）。
#
# 注意：Caddy 的 default_sni 不接受空值 —— 留空会让整个配置解析失败、反代起不来，
# 所以这里必须带默认值（启动器也会在值有问题时把它摘掉并告警，见 ops/docker/proxy.py）。
{
	skip_install_trust
	admin off
	auto_https disable_redirects
	default_sni {$APP_HTTPS_DEFAULT_SNI:homeos.local}
	# 控制台只打错误；证书维护 / GOMAXPROCS 等 info 刷屏关掉
	log {
		level ERROR
		format console
	}
	# h1 支持 WebSocket 升级，h2 用于常规 HTTP/2
	servers :8803 {
		protocols h1 h2
	}
}

# 裸 :8803 匹配任意主机名 / IP；IP 直连（无 SNI）由上面的 default_sni 兜住
:8803 {
	tls internal {
		on_demand
	}

	# ── 健康检查不进访问日志 ─────────────────────────────────────────────────────
	# 容器 HEALTHCHECK（docker-compose*.yml 的 `interval: 30s`）会打
	# `https://localhost:8803/health/ready`，每 30s 一条，一整天 2880 条 ≈ 4MB ——
	# 而日志轮转预算是 10MB × 3，健康检查会稳定吃掉约 13% 的窗口，把真实报错更早挤出去。
	#
	# 滤掉不会丢信号，健康状态有三个独立来源：
	#   · 容器 health 状态（`docker ps` 的 healthy/unhealthy）—— 这条探测本身的结果；
	#   · Caddy 自己每 15s 的主动探测（下面 reverse_proxy 的 health_uri，不经站点处理器、
	#     本来就不产生访问日志），它管的是 8801 上游是否活着；
	#   · 应用 /metrics 的 `homeos_http_requests_total` / 路由直方图。
	# `log_skip` 实测（caddy:2.11.8-alpine，仓库钉的版本）：只吞 /health/*，其余请求照常入日志。
	@health path /health/ready /health/live
	log_skip @health

	# ── 访问日志（性能报告 B16）────────────────────────────────────────────────────
	# 每个请求一条 JSON 到 stdout：容器里由 docker 的 json-file 驱动收集（max-size/max-file
	# 轮转见 docker-compose*.yml），也便于宿主侧直接接采集器。与全局块里 Caddy 自身进程
	# 日志（ERROR 级 console）是两条独立通道，互不影响。
	log {
		output stdout
		format json
	}

	# ── 静态资源压缩（只匹配 /static/*，不给 /api/* 开）───────────────────────────
	#
	# 为什么压：3D 模型的 GLB 是 f32 几何，HTTP 传输可压得很狠。以下数字均为**实测**
	# （真实本文件只换端口、去掉 tls，上游直吐文件，逐文件过反代统计）：
	#   · 全库 660 个 GLB：27.24 MB → zstd 11.37 MB（省 58.3%）/ gzip 11.93 MB（省 56.2%）；
	#   · 单件（均按 zstd 计，括号内 gzip）：`piano.glb` 62.5%（61.8%）、
	#     `round-double-bed.glb` 67.6%、`coffeetable.glb` 72.4%（68.1%）、
	#     `draco_decoder.wasm` 68.0%（65.6%）、SVG 样例 64.6%；
	#   · 非 GLB 静态资源 7665 个：18.32 MB → 7.41 MB（省 59.6%）。
	# 压缩在**传输层**做，文件本身一格不动。
	#
	# 两个容易踩的边界（同样是实测）：
	#   · encode 默认 `min_length` 是 512 B —— 小文件直接不压（200 B 文本原样透传，900 B 才压）；
	#   · 已压格式（webp / woff2）压完反而略大：全库仅 35 个、合计 +513 B，可忽略。
	# 这里只挂 zstd + gzip，**没配 br**：标准 caddy 官方构建不带 brotli 模块，硬加 `br` 会让
	# 配置解析失败、反代起不来（换带插件的自编译镜像代价与收益不匹配）。只发
	# `Accept-Encoding: br` 的客户端由**构建期预压缩 sidecar** 兜住：/static 下每个可压缩
	# 文件旁都有同名 .br / .gz（ops/scripts/precompress-static.mjs 生成），后端
	# PrecompressedStaticFiles 按 Accept-Encoding 优先直出 br；encode 见到响应已带
	# Content-Encoding 时不会二次编码。主流浏览器同时接受 gzip，实际不退化。
	#
	# 为什么必须写 `match { header Content-Type * }`：Caddy 的 encode 默认只压「可压缩
	# 文本类型」，实测**会跳过** `model/gltf-binary`（287196 B 原样透传、无 Content-Encoding）；
	# 显式给 content-type 匹配后同一文件才降到 107673 B（zstd）。对照实验：删掉这个 match
	# 子块后 GLB 两件全部原样透传，而 SVG 仍被压到 2169 B —— 说明失效点只在 MIME 判定。
	# `header Content-Type *` 是通配，保持「/static 下都交给编码器」的语义 —— 目录里那批位图
	# 与 woff2 属于已压格式（压完略大，见上），SVG 反而收益大，整体代价可忽略。
	#
	# 为什么不给整站开：/api/* 里有 SSE 与 go2rtc 的实时流（multipart / 长连接），
	# 让 encode 去缓冲它们会破坏流式语义；这里用 path 匹配把风险面收干净（实测 /api/* 不带
	# Content-Encoding）。
	@static_assets path /static/*
	encode @static_assets {
		zstd
		gzip
		match {
			header Content-Type *
		}
	}

	reverse_proxy 127.0.0.1:{$APP_PORT:8801} {
		# ── 健康检查 / 超时 / 流式（性能报告 B16）────────────────────────────────────
		# 主动探测上游 /health/ready：应用启动中或崩溃重启期间，反代快速失败而不是把请求
		# 打到一个半死的上游（与 depends_on、容器 HEALTHCHECK 互补，后者管容器生命周期）。
		health_uri /health/ready
		health_interval 15s
		health_timeout 5s
		# WebSocket / SSE / go2rtc 流：不缓冲、立即转发；反代层面不设 read timeout，
		# 长连接存活由上游心跳决定（Caddy 不会截断已升级的 WebSocket）。
		flush_interval -1
		transport http {
			# 建连上限 5s；3D 大资源 / 慢接口的响应头等待上限 60s（默认 0=不限，
			# 给个上限避免慢查询长期占住连接）。
			dial_timeout 5s
			response_header_timeout 60s
		}
		# 上游端口来自 APP_PORT（与 ops/docker/start_app.py 给 uvicorn 的 --port 同源）。
		# 不能写死 8801：APP_PORT 是可配的（.env.example 就写着「镜像入口读 APP_PORT」），
		# 改了端口而这里不变，反代就永久盯着一个没人监听的端口 —— 全站 502，而症状
		# （connection refused）和「应用还没起来」一模一样，很难查到根因。
		# 必须用 hostport，不能写 {host}：{host} 等价于 {http.request.host}，Caddy 会做
		# net.SplitHostPort 把端口摘掉。于是上游收到的 Host 是「192.168.1.20」，而浏览器
		# 发来的 Origin 是「https://192.168.1.20:8803」—— 应用的来源校验按 netloc 逐字比对
		# （platform/security/request_origin.py、api/ha/routes.py 的 WebSocket 校验），
		# 结果是 8803 入口下写操作 / HA / go2rtc 实时通道 403，而 8801 与 443 都正常。
		header_up Host {http.request.hostport}
		header_up X-Real-IP {remote_host}
	}
}
