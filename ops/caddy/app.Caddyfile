# HomeOS 主应用 —— 镜像内置的内网 HTTPS 反代（Caddy 内置 CA，按需自签证书）
#
# 由 ops/docker/start_app.py 在容器内与 uvicorn 同容器拉起：监听 :8803，
# 反代到同容器的 127.0.0.1:8801。因为反代就在应用旁边：
#   - 不要求把 8801 先发布到宿主机；
#   - 这条内置反代的对端永远是回环，uvicorn 信任 127.0.0.1,::1 就够。compose 里之所以还写了
#     docker 网段（APP_TRUSTED_PROXIES / UVICORN_FORWARDED_ALLOW_IPS 含 172.16.0.0/12），
#     是为了**另一条**链路：内网穿透 / 宿主反代回灌到已发布的 8801 时，容器看到的源是网桥
#     网关 172.x。两者互不影响。
# Dockerfile 会在构建时把本文件复制为 /etc/caddy/Caddyfile。
#
#   - 裸 :8803 站点 + tls internal { on_demand }：证书按连入的 SNI 动态签发 —— 用**主机名**
#     访问（例如 https://homeos.local:8803）天然就对得上；
#   - HTTP 备用：继续直连容器发布的 8801，不经本反代；
#   - WebSocket 由 Caddy v2 reverse_proxy 默认自动升级。
#
# ── default_sni 为什么必须有（别删）─────────────────────────────────────────────
#
# 浏览器访问 **IP 字面量**时**不发 SNI**（RFC 6066：SNI 只能是主机名，IP 不算）。这样
# on_demand 拿不到任何名字，只能按「本机地址」签发 —— 那是容器自己的 docker IP
# （实测证书 SAN = IP:172.19.0.3），于是浏览器判「证书与地址不匹配」：
# https://<局域网IP>:8803 打不开，部分 WebView / PWA 安装还会硬拦（连「继续前往」都没有）。
#
# default_sni 就是给「没有 SNI 的连接」兜底的那个名字：把它设成你实际输入的那个地址
# （一般就是局域网 IP），证书才会签给这个地址、浏览器才只报「不受信任的 CA」这一步。
# 取值来自 APP_HTTPS_DEFAULT_SNI（compose 注入，见 docker-compose.yml / .env.example）。
#
# 注意：Caddy 的 default_sni 不接受空值 —— 留空会让整个配置解析失败、反代起不来，
# 所以这里必须带默认值（启动器也会在值有问题时把它摘掉并告警，见 ops/docker/proxy.py）。
{
	skip_install_trust
	admin off
	auto_https disable_redirects
	default_sni {$APP_HTTPS_DEFAULT_SNI:homeos.local}
	# 控制台只打错误；证书维护 / GOMAXPROCS 等 info 刷屏关掉
	log {
		level ERROR
		format console
	}
	# h1 支持 WebSocket 升级，h2 用于常规 HTTP/2
	servers :8803 {
		protocols h1 h2
	}
}

# 裸 :8803 匹配任意主机名 / IP；IP 直连（无 SNI）由上面的 default_sni 兜住
:8803 {
	tls internal {
		on_demand
	}

	reverse_proxy 127.0.0.1:8801 {
		# 必须用 hostport，不能写 {host}：{host} 等价于 {http.request.host}，Caddy 会做
		# net.SplitHostPort 把端口摘掉。于是上游收到的 Host 是「192.168.1.20」，而浏览器
		# 发来的 Origin 是「https://192.168.1.20:8803」—— 应用的来源校验按 netloc 逐字比对
		# （platform/security/request_origin.py、api/ha.py 的 WebSocket 校验），
		# 结果是 8803 入口下写操作 / HA / go2rtc 实时通道 403，而 8801 与 443 都正常。
		header_up Host {http.request.hostport}
		header_up X-Real-IP {remote_host}
	}
}
