# 生产反代示例（Nginx）
#
# 与 ops/deploy/Caddyfile.example 同拓扑：homeos / pay 两个域名。
# 请先用 certbot 或其它方式准备证书，再填 ssl_certificate 路径。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream homeos_app {
    server 127.0.0.1:18081;
}

upstream homeos_store {
    server 127.0.0.1:18082;
}

# 响应压缩。两条容易踩空的点：
#
#   1. **gzip_proxied 默认是 off**。本文件里的每一份响应都来自反代，不写这一行 nginx 一律不压 ——
#      而「写了几行 gzip 配置、一个字节也没压下去」不会有任何报错，只表现为首屏一直慢着。
#   2. **应用自己也压**（见 backend/src/http/compression.py 与 backend/src/security/compression.py）。
#      它压过的响应带 Content-Encoding: gzip，nginx 原样透传、不会二次压缩，两边同时开着是
#      幂等的；反过来，直连 18081 / 18082 的路径（墙面板走局域网、compose 未挂反代）就只有
#      应用那一层在压，所以这两处都要开。
gzip on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
# 只压文本类。图片 / 字体（woff2 本身就是压缩格式）/ 视频分片压了只会更慢；
# m3u8 播放清单是纯文本、值得压，而 ts / fmp4 分片**千万不要**加进来。
# （text/html 由 nginx 内置，不必列。）
gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/manifest+json
    application/xml
    image/svg+xml
    application/vnd.apple.mpegurl;

server {
    listen 443 ssl http2;
    server_name homeos.example.com;

    ssl_certificate     /etc/ssl/certs/homeos.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/homeos.example.com.key;

    client_max_body_size 64m;

    location / {
        proxy_pass http://homeos_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 443 ssl http2;
    server_name pay.example.com;

    ssl_certificate     /etc/ssl/certs/pay.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/pay.example.com.key;

    client_max_body_size 16m;

    location / {
        proxy_pass http://homeos_store;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
