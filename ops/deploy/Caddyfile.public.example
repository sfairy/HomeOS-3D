# 公网接入示例（Caddy 2）—— 授权商店用真实域名 + 自动签发的可信证书
#
# 与 docker-compose.yml 里那段「可选：内置 Caddy 入口」（取消注释即用）配套：
#
#   caddy-public 的 environment 里填 STORE_DOMAIN: store.example.com / ACME_EMAIL: you@example.com
#   docker compose up -d
#
# 原理：
#   - 域名解析到本机公网 IP，Caddy 用 ACME（HTTP-01 / TLS-ALPN）自动申请并续期证书；
#   - 证书是公共 CA 签的，所以**客户机里的主应用也能正常校验**（这一点与镜像内置反代
#     用的 Caddy 内部 CA 自签证书不同：自签在跨机 HTTPS 时会被 httpx/urllib 拒绝）；
#   - 反代在商店容器**之外**（另一个容器），终止 TLS 后按内网明文转给商店的 8802。
#
# 因此商店侧必须放宽可信代理（docker-compose.yml 里的 STORE_TRUSTED_PROXIES）：
# 否则商店会把反代容器当成客户端本人，真实来源 IP、登录限流与审计一起失真。
# 收敛到 docker 网段即可（本文件的上游是 homeos-store，从 172.16.0.0/12 连进来），别填 *。
#
# 商店侧**没有** UVICORN_FORWARDED_ALLOW_IPS：商店的 uvicorn 不带 --proxy-headers
# （homeos-store/backend/src/run.py），转发头完全由 STORE_TRUSTED_PROXIES 判定。
#
# Caddy 默认不限制请求体大小，所以商品图上传（商店侧上限 16 MiB，见
# homeos-store/backend/src/security/body_guard.py）不会被这一层拦掉；
# 换成 nginx / OpenResty 时记得设 client_max_body_size 16m（见 openresty.store.conf.example）。
#
# 域名与邮箱都走环境变量，本文件不用改。

{
	admin off
	# ACME 账号邮箱（证书到期/吊销通知用）。**必填**：Caddy 的 email 不接受空值，
	# 留空会让配置解析失败（compose overlay 里因此也把它设成必填）。
	email {$ACME_EMAIL}
	log {
		level ERROR
		format console
	}
}

# 裸域名站点：Caddy 按 {$STORE_DOMAIN} 自动匹配并申请证书。
{$STORE_DOMAIN} {
	encode zstd gzip

	# 上游固定为同项目内的商店服务名（compose 网络内解析）。
	reverse_proxy homeos-store:8802 {
		# 用 hostport：域名在 443 上两者等价，但一旦换成非默认端口（本地调试常这么干），
		# {host} 会摘掉端口，商店的 same_origin_request 按 netloc 比对就会 403。
		header_up Host {http.request.hostport}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 说明：
# - 支付回调（/store/v1/payments/alipay/notify 等）就是这个域名下的路径，
#   只要 STORE_BASE_URL 是本域名即可自动推导，无需在本文件另加规则。
# - 想同时保留 IP 直连调试，可临时加一个 :80 站点；公网环境不建议暴露明文。
# - 若前置已有负载均衡 / CDN 终止 TLS，就别用本文件与 overlay，直接按你的入口配置
#   转发到商店 8802，并把可信代理改成那一层入口的地址。
