{
  "name": "homeos-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run build:vite && bun run obfuscate",
    "build:backend": "python3 ops/build.py backend",
    "build:vite": "bun run --cwd homeos-3d build && bun run --cwd homeos-store build",
    "build:3d": "bun run --cwd homeos-3d build && bun run obfuscate:3d",
    "build:store": "bun run --cwd homeos-store build && bun run obfuscate:store",
    "obfuscate": "bun ops/docker/obfuscate_javascript.mjs dist/homeos-3d/frontend/static dist/homeos-3d/frontend/modules/runtime dist/homeos-store/frontend/static",
    "obfuscate:3d": "bun ops/docker/obfuscate_javascript.mjs dist/homeos-3d/frontend/static dist/homeos-3d/frontend/modules/runtime",
    "obfuscate:store": "bun ops/docker/obfuscate_javascript.mjs dist/homeos-store/frontend/static",
    "image": "python3 ops/build.py image",
    "image:3d": "python3 ops/build.py image --project 3d",
    "image:store": "python3 ops/build.py image --project store",
    "typecheck": "bun run --cwd homeos-3d typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "verify:scene": "python3 ops/verify_scene_sync.py",
    "verify:smoke": ".venv-store/bin/python homeos-store/tools/smoke_store.py",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos-3d dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:3d": "bun run --cwd homeos-3d dev",
    "dev:store": "bun run --cwd homeos-store dev"
  },
  "workspaces": ["homeos-3d", "homeos-store"],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "javascript-obfuscator": "^5.8.1",
    "typescript": "^7.0.2"
  }
}
