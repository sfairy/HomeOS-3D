{
  "name": "homeos-monorepo",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:shared": "bun run --cwd packages/shared build",
    "build:frontend": "bun run build:vite",
    "build:backend": "python3 ops/build.py backend",
    "build:vite": "bun run build:shared && bun run --cwd homeos build && bun run --cwd homeos-store build",
    "build:app": "bun run --cwd homeos build",
    "build:store": "bun run --cwd homeos-store build",
    "image": "python3 ops/build.py image",
    "image:app": "python3 ops/build.py image --project app",
    "image:store": "python3 ops/build.py image --project store",
    "typecheck": "bun run build:shared && bun run --cwd homeos typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "audit:materials": "bun ops/checks/studio/audit_glb_materials.mjs",
    "check:materials": "bun ops/checks/studio/audit_glb_materials.mjs --check",
    "check:materials:roles": "bun ops/checks/studio/audit_glb_materials.mjs --check-roles",
    "audit:materials:roles": "bun ops/checks/studio/audit_glb_materials.mjs --write-role-baseline",
    "probe:materials": "bun ops/checks/studio/material_render_probe.mjs --check",
    "probe:pillar": "bun ops/checks/studio/pillar_wall_probe.mjs --check",
    "check:pillar": "bun ops/checks/studio/pillar_wall_probe.mjs --spec-only && bun ops/checks/studio/pillar_wall_probe.mjs --spec-only --palette warm-wood",
    "repair:materials": "bun ops/checks/studio/repair_glb_materials.mjs",
    "check:models-layout": "bun homeos/frontend/scripts/models/organize-models.mjs --check",
    "organize:models": "bun homeos/frontend/scripts/models/organize-models.mjs --write",
    "index:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs",
    "check:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs --check",
    "repair:materials:write": "bun ops/checks/studio/repair_glb_materials.mjs --write",
    "repair:materials:rename": "bun ops/checks/studio/repair_glb_materials.mjs --write --rename-slots --force-rename",
    "lint:shared": "bun run --cwd packages/shared lint",
    "lint:ops": "eslint ops --max-warnings 0",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:frontend": "bun run --cwd homeos dev:frontend",
    "dev:app": "bun run --cwd homeos dev:frontend",
    "dev:store": "bun run --cwd homeos-store dev",
    "diff:source": "node ops/scripts/diff-source-versions.mjs",
    "check:async-db": ".venv-store/bin/python ops/checks/check_async_db.py",
    "check:frontend-deps": "bun run --cwd homeos/frontend check:deps",
    "check:routes": ".venv-store/bin/python ops/checks/architecture/route_inventory.py --check",
    "test:architecture": ".venv-store/bin/python -m unittest discover -s ops/checks/architecture/tests -v",
    "check:bundle-budget": "bun ops/checks/check_bundle_budget.mjs",
    "perf:baseline": "bash ops/perf/harness/run_baseline.sh before",
    "perf:after": "bash ops/perf/harness/run_baseline.sh after",
    "perf:3d": "node ops/perf/harness/bench_3d.mjs --label after",
    "perf:contracts": ".venv-store/bin/python ops/perf/harness/check_contracts.py --label after",
    "perf:compare": ".venv-store/bin/python ops/perf/harness/compare_metrics.py --before before --after after",
    "check:code-quality": "node ops/checks/code_quality/run.mjs",
    "check:studio-split": "node ops/checks/studio/check_split_budget.mjs --phase 3 && node ops/checks/studio/verify_item_model.mjs",
    "test:studio-split": ".venv-store/bin/python -m unittest discover -s ops/checks/studio/tests -v",
    "check:studio-naming": "node ops/checks/studio/check_naming.mjs --report",
    "naming:report": "node ops/checks/naming/check_naming.mjs --report",
    "naming:apply": "node ops/checks/naming/rename.mjs",
    "check:naming": "node ops/checks/naming/check_naming.mjs --check",
    "test:naming": "node --test ops/checks/naming/tests/",
    "verify:item-model": "node ops/checks/studio/verify_item_model.mjs",
    "audit:geometry": "bun ops/checks/studio/audit_glb_geometry.mjs",
    "check:geometry": "bun ops/checks/studio/audit_glb_geometry.mjs --check",
    "repair:geometry": "bun ops/checks/studio/repair_glb_geometry.mjs",
    "repair:geometry:write": "bun ops/checks/studio/repair_glb_geometry.mjs --write",
    "repair:scene": "bun ops/checks/studio/repair_glb_scene.mjs",
    "repair:scene:write": "bun ops/checks/studio/repair_glb_scene.mjs --write",
    "render:models": "bun ops/checks/studio/render_glb.mjs --all-flagships --views front,iso,side",
    "render:slots": "bun ops/checks/studio/render_glb.mjs --all-flagships --mode slots --views front,iso",
    "audit:slots": "bun ops/checks/studio/audit_glb_material_slots.mjs",
    "check:slots": "bun ops/checks/studio/audit_glb_material_slots.mjs --check",
    "repair:slots": "bun ops/checks/studio/repair_glb_material_slots.mjs",
    "repair:slots:write": "bun ops/checks/studio/repair_glb_material_slots.mjs --write",
    "check:slot-roles": "bun ops/checks/studio/verify_slot_roles.mjs",
    "check:variants": "bun ops/checks/studio/ensure_variants.mjs",
    "check:assets": "bun ops/checks/studio/audit_glb_assets.mjs --check",
    "audit:assets": "bun ops/checks/studio/audit_glb_assets.mjs",
    "check:quality": "bun ops/checks/studio/compare_model_quality.mjs --check",
    "audit:quality": "bun ops/checks/studio/compare_model_quality.mjs",
    "preview:smoke": "bun ops/checks/studio/preview_smoke.mjs",
    "rebuild:items": "bun homeos/frontend/scripts/models/rebuild-items.mjs --all --write",
    "build:slot-contracts": "bun homeos/frontend/scripts/models/build-slot-contracts.mjs"
  },
  "workspaces": [
    "homeos",
    "homeos/frontend",
    "packages/shared",
    "homeos-store"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.22.0",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.5.0",
    "valibot": "1.5.0",
    "find-my-way": "9.10.0",
    "fast-uri": "4.2.3",
    "file-type": "22.2.0",
    "socket.io-parser": "4.2.7",
    "multer": "2.5.0",
    "nanoid": "3.3.20",
    "pg": "8.23.1",
    "postcss": "8.5.31",
    "typescript": "6.0.3",
    "pinia": "4.1.0",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "draco3dgltf": "^1.5.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
