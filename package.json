{
  "name": "homeos-monorepo",
  "private": true,
  "version": "0.8.9",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:shared": "bun run --cwd packages/shared build",
    "build:frontend": "bun run build:vite && bun run minify:static-css && bun run precompress:static",
    "minify:static-css": "node ops/scripts/minify-static-css.mjs",
    "check:minified-css": "node ops/scripts/minify-static-css.mjs --check",
    "precompress:static": "node ops/scripts/precompress-static.mjs",
    "check:precompress": "node ops/scripts/precompress-static.mjs --check",
    "build:backend": "node ops/lib/py.mjs ops/build.py backend",
    "build:vite": "bun run build:shared && bun run --cwd homeos build && bun run --cwd homeos-store build",
    "build:app": "bun run --cwd packages/shared sync:scene && bun run --cwd homeos build",
    "build:store": "bun run --cwd packages/shared sync:scene && bun run --cwd homeos-store build",
    "check:scene": "bun run --cwd packages/shared check:scene",
    "check:css-syntax": "bun run --cwd homeos/frontend check:css && bun run --cwd homeos-store check:css && bun run --cwd packages/shared check:css",
    "check:css-manifests": "node ops/checks/frontend/check_css_manifests.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "set-version": "bun ops/release/set-version.mjs",
    "clean:local": "bun ops/dev/clean-local.mjs",
    "image": "node ops/lib/py.mjs ops/build.py image",
    "image:app": "node ops/lib/py.mjs ops/build.py image --project app",
    "image:store": "node ops/lib/py.mjs ops/build.py image --project store",
    "typecheck": "bun run build:shared && bun run --cwd homeos typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "gate": "node ops/gates.mjs",
    "gate:static": "node ops/gates.mjs --group static",
    "gate:fast": "node ops/gates.mjs --group static --tag types,lint",
    "gate:model": "node ops/gates.mjs --group model",
    "gate:build": "node ops/gates.mjs --group build",
    "gate:infra": "node ops/gates.mjs --group infra",
    "check:frontend": "node ops/checks/run_frontend_checks.mjs",
    "check:backend": "node ops/lib/py.mjs ops/checks/run_backend_checks.py",
    "report:slow-sql": "node ops/lib/py.mjs ops/scripts/slow_query_report.py",
    "check:e2e": "node ops/checks/e2e/smoke.mjs",
    "bench:backend": "node ops/lib/py.mjs ops/bench/run_bench.py",
    "check:contracts": "node ops/lib/py.mjs ops/checks/run_contract_checks.py",
    "check:tests": "bun ops/checks/run_tests.mjs",
    "check:studio-invariants": "node ops/checks/run_studio_invariants.mjs",
    "check:model-assets": "bun ops/checks/run_model_checks.mjs --module assets,geometry,slots,materials",
    "check:model-index": "bun ops/checks/run_model_checks.mjs --module models-layout,model-names",
    "check:env": "node ops/checks/contract/check_env_inventory.mjs && node ops/lib/py.mjs ops/checks/python/check_env_access.py",
    "check:deps": "bun run check:frontend-deps && node ops/lib/py.mjs ops/checks/architecture/check_backend_deps.py --check",
    "check:dist-assets": "node ops/scripts/minify-static-css.mjs --check && node ops/scripts/precompress-static.mjs --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint:py": "node ops/lib/py.mjs -m ruff check . && node ops/lib/py.mjs ops/checks/python/check_python_format.py",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:frontend": "bun run --cwd homeos dev:frontend",
    "dev:store": "bun run --cwd homeos-store dev",
    "reset:schema-baseline": "node ops/lib/py.mjs ops/scripts/reset-schema-version.py",
    "prune:agent-timeline": "node ops/lib/py.mjs ops/scripts/prune-agent-timeline.py",
    "check:plan-geometry": "node ops/checks/studio/plan-geometry-invariants.mjs",
    "check:studio-placement": "node ops/checks/studio/studio-placement-invariants.mjs",
    "check:studio-gesture": "node ops/checks/studio/studio-editor-gesture-invariants.mjs",
    "check:studio-parity": "bun ops/scripts/studio-visual-parity.mjs",
    "dev:ref": "bun ops/dev/ref-087-proxy.mjs",
    "check:studio-window-undo": "node ops/checks/studio/studio-window-undo.mjs",
    "check:scene-payload": "node ops/checks/studio/scene-payload-invariants.mjs",
    "check:silent-except": "node ops/lib/py.mjs ops/checks/python/check_silent_except.py",
    "check:error-contract": "node ops/lib/py.mjs ops/checks/python/check_error_contract.py",
    "check:background-tasks": "node ops/lib/py.mjs ops/checks/python/check_background_tasks.py",
    "check:env-access": "node ops/lib/py.mjs ops/checks/python/check_env_access.py",
    "check:python-lock": "node ops/lib/py.mjs ops/ci/python_lock.py verify",
    "check:image-imports": "node ops/lib/py.mjs ops/ci/image_imports.py",
    "check:cython": "node ops/lib/py.mjs ops/ci/cython_check.py",
    "check:frontend-deps": "bun run --cwd homeos/frontend check:deps && node ops/checks/frontend/check_frontend_deps.mjs --root homeos-store/frontend/src --alias '@store/='",
    "check:restricted-syntax": "node ops/checks/frontend/check_restricted_syntax.mjs",
    "check:offline-counting": "node ops/checks/frontend/check_offline_counting.mjs",
    "audit:scaling": "bun ops/checks/frontend/check_canvas_layout.mjs --json",
    "check:backend-deps": "node ops/lib/py.mjs ops/checks/architecture/check_backend_deps.py --check",
    "check:ws-auth": "node ops/lib/py.mjs ops/checks/security/check_ws_auth.py --check",
    "check:routes": "node ops/lib/py.mjs ops/checks/architecture/route_inventory.py --check",
    "check:store-routes": "node ops/lib/py.mjs ops/checks/architecture/store_route_inventory.py --check",
    "check:api-contract": "node ops/lib/py.mjs ops/checks/architecture/api_contract_coverage.py",
    "check:frontend-coverage": "node ops/lib/py.mjs ops/checks/architecture/frontend_route_coverage.py --check",
    "update:frontend-coverage": "node ops/lib/py.mjs ops/checks/architecture/frontend_route_coverage.py --write",
    "report:frontend-coverage": "node ops/lib/py.mjs ops/checks/architecture/frontend_route_coverage.py --report",
    "check:backend-unit-tests": "node ops/lib/py.mjs ops/checks/unittests/run.py",
    "check:selftests": "node ops/lib/py.mjs ops/checks/run_selftests.py",
    "check:device-profile": "node ops/lib/py.mjs ops/checks/business/device_profile_selftest.py",
    "check:device-health": "node ops/lib/py.mjs ops/checks/business/device_health_selftest.py",
    "check:backup": "node ops/lib/py.mjs ops/checks/business/backup_selftest.py",
    "check:event-log": "node ops/lib/py.mjs ops/checks/business/event_log_selftest.py",
    "check:water-monitor": "node ops/lib/py.mjs ops/checks/business/water_monitor_selftest.py",
    "check:energy-guard": "node ops/lib/py.mjs ops/checks/business/energy_guard_selftest.py",
    "check:iaq-monitor": "node ops/lib/py.mjs ops/checks/business/iaq_monitor_selftest.py",
    "check:circadian": "node ops/lib/py.mjs ops/checks/business/circadian_selftest.py",
    "check:sun-trigger": "node ops/lib/py.mjs ops/checks/business/sun_trigger_selftest.py",
    "check:home-mode-restore": "node ops/lib/py.mjs ops/checks/business/home_mode_restore_selftest.py",
    "check:entry-delay": "node ops/lib/py.mjs ops/checks/business/security_entry_delay_selftest.py",
    "check:device-timer": "node ops/lib/py.mjs ops/checks/business/device_timer_selftest.py",
    "check:energy-cost": "node ops/lib/py.mjs ops/checks/business/energy_cost_selftest.py",
    "check:energy-hourly": "node ops/lib/py.mjs ops/checks/business/energy_hourly_selftest.py",
    "check:notif-mute": "node ops/lib/py.mjs ops/checks/business/notification_mute_selftest.py",
    "check:public-config": "node ops/lib/py.mjs ops/checks/business/public_config_selftest.py",
    "check:store-links": "node ops/lib/py.mjs ops/checks/business/store_links_selftest.py",
    "check:ui-assets": "node ops/lib/py.mjs ops/checks/business/ui_assets_selftest.py",
    "check:timeline": "node ops/lib/py.mjs ops/checks/business/timeline_selftest.py",
    "check:security": "node ops/lib/py.mjs ops/checks/business/security_selftest.py",
    "check:command-proxy": "node ops/lib/py.mjs ops/checks/business/command_proxy_selftest.py",
    "check:canvas-layout": "bun ops/checks/frontend/check_canvas_layout.mjs",
    "check:state-revision": "bun ops/checks/studio/state_revision_selftest.mjs",
    "check:toolchain": "node ops/checks/contract/check_toolchain.mjs",
    "check:env-inventory": "node ops/checks/contract/check_env_inventory.mjs",
    "check:python-format": "node ops/lib/py.mjs ops/checks/python/check_python_format.py",
    "check:font-subset": "node homeos-store/frontend/scripts/build-font-subset.mjs --check",
    "generate:font-subset": "node homeos-store/frontend/scripts/build-font-subset.mjs --write",
    "check:chunk-init": "bun ops/checks/frontend/check_chunk_init_order.mjs --strict",
    "check:runtime-contract": "node ops/checks/studio/check_runtime_contract.mjs",
    "check:materials": "bun ops/checks/studio/audit_glb_materials.mjs --check",
    "check:models-layout": "bun homeos/frontend/scripts/models/organize-models.mjs --check",
    "organize:models": "bun homeos/frontend/scripts/models/organize-models.mjs --write",
    "index:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs",
    "check:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs --check",
    "check:geometry": "bun ops/checks/studio/audit_glb_geometry.mjs --check",
    "check:slots": "bun ops/checks/studio/audit_glb_material_slots.mjs --check",
    "check:assets": "bun ops/checks/studio/audit_glb_assets.mjs --check",
    "rebuild:items": "bun homeos/frontend/scripts/models/rebuild-items.mjs --all --write",
    "build:slot-contracts": "bun homeos/frontend/scripts/models/build-slot-contracts.mjs",
    "compose:public": "node ops/lib/py.mjs ops/ci/compose_public.py",
    "generate:slot-tables": "bun ops/checks/studio/repair_glb_material_slots.mjs --emit-generated",
    "check:unit-tests": "bun test ops/checks/unittests",
    "check:parity": "node ops/lib/py.mjs ops/checks/contract/check_parity.py --check",
    "check:guards": "node ops/lib/py.mjs ops/checks/python/check_guards.py --check",
    "soak": "node ops/checks/perf/soak.mjs",
    "drill:restore": "node ops/lib/py.mjs ops/scripts/backup_restore_drill.py",
    "check:default-fonts": "node ops/lib/py.mjs ops/scripts/compress-default-fonts.py --check"
  },
  "workspaces": [
    "homeos",
    "homeos/frontend",
    "packages/shared",
    "homeos-store"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.23.0",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.13",
    "js-yaml": "5.5.0",
    "valibot": "1.5.0",
    "find-my-way": "9.10.2",
    "fast-uri": "4.2.3",
    "follow-redirects": "1.16.3",
    "minimatch": "11.0.9",
    "file-type": "22.3.0",
    "socket.io-parser": "4.2.7",
    "multer": "2.5.0",
    "nanoid": "3.3.20",
    "pg": "8.23.1",
    "postcss": "8.5.33",
    "typescript": "6.0.3",
    "pinia": "4.1.0",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "draco3dgltf": "^1.5.9",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "meshoptimizer": "^1.3.0",
    "pinia": "^4.1.0",
    "postcss": "^8.5.33",
    "three": "0.187.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
