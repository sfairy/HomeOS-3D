{
  "name": "homeos-monorepo",
  "private": true,
  "version": "0.7.6",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:shared": "bun run --cwd packages/shared build",
    "build:frontend": "bun run build:vite && bun run obfuscate",
    "build:backend": "python3 ops/build.py backend",
    "build:vite": "bun run build:shared && bun run --cwd homeos build && bun run --cwd homeos-store build",
    "build:app": "bun run --cwd homeos build && bun run obfuscate:app",
    "build:store": "bun run --cwd homeos-store build && bun run obfuscate:store",
    "obfuscate": "bun ops/docker/obfuscate_javascript.mjs dist/homeos/frontend/static dist/homeos/frontend/assets dist/homeos/frontend/modules/runtime dist/homeos-store/frontend/static",
    "obfuscate:app": "bun ops/docker/obfuscate_javascript.mjs dist/homeos/frontend/static dist/homeos/frontend/assets dist/homeos/frontend/modules/runtime",
    "obfuscate:store": "bun ops/docker/obfuscate_javascript.mjs dist/homeos-store/frontend/static",
    "image": "python3 ops/build.py image",
    "image:app": "python3 ops/build.py image --project app",
    "image:store": "python3 ops/build.py image --project store",
    "typecheck": "bun run build:shared && bun run --cwd homeos typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:py": "bun run --cwd homeos typecheck:py",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "lint:shared": "bun run --cwd packages/shared lint",
    "lint:ops": "eslint ops --max-warnings 0",
    "knip": "knip --reporter compact",
    "slice:studio": "node ops/studio/studio_slice_analyze.mjs",
    "slice:studio:extract": "node ops/studio/studio_slice_extract.mjs",
    "slice:studio:wrap": "node ops/studio/studio_slice_wrap.mjs",
    "slice:studio:apply": "node ops/studio/studio_slice_apply.mjs",
    "slice:studio:restore-imports": "node ops/studio/restore_import_formatting.mjs",
    "seam:studio:template": "node ops/studio/studio_template_seam.mjs",
    "seam:studio:template:selftest": "node homeos/frontend/scripts/gates/_studio_template_seam_selftest.mjs",
    "seam:studio:editor-view": "node ops/studio/studio_template_seam.mjs --plan=ops/plans/studio/editor-view-template.json",
    "kpi:studio": "python3 ops/kpi/studio_monolith_kpi.py && python3 ops/kpi/studio_domains_kpi.py && python3 ops/kpi/studio_layout_kpi.py",
    "verify:scene": "python3 ops/check/verify_scene_sync.py",
    "verify:assets": "python3 ops/check/verify_assets.py && python3 ops/check/verify_assets_selftest.py",
    "verify:env": "python3 ops/check/check_production_env.py && python3 ops/check/check_production_env.py --selftest",
    "verify:tokens": "node ops/tokens/check-token-contract.mjs",
    "verify:style": "node ops/style/check-style-debt.mjs && node ops/style/_style_debt_selftest.mjs",
    "verify:features": "python3 ops/check/check_feature_codes.py",
    "verify:contracts": "node ops/lib/run-chain.mjs ops/chains/verify-contracts.mjs",
    "verify:independence": "python3 ops/check/check_deploy_independence.py && python3 ops/check/check_deploy_independence_selftest.py",
    "verify:schema": "${PYTHON:-.venv-store/bin/python} ops/check/check_schema.py",
    "verify:database": "${PYTHON:-.venv-store/bin/python} ops/check/check_database.py",
    "verify:smoke": "node ops/lib/run-chain.mjs ops/chains/smoke-store.mjs",
    "verify:smoke:app": "node ops/lib/run-chain.mjs ops/chains/smoke-app.mjs",
    "verify:smoke:frontend": "node ops/lib/run-chain.mjs ops/chains/smoke-frontend.mjs",
    "verify:smoke:license": "node ops/lib/run-chain.mjs ops/chains/smoke-license.mjs",
    "verify:smoke:all": "node ops/lib/run-chain.mjs ops/chains/smoke-all.mjs",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:app": "bun run --cwd homeos dev",
    "dev:store": "bun run --cwd homeos-store dev",
    "verify:tokenmap": "node ops/tokens/check-token-map.mjs",
    "diff:source": "node ops/scripts/diff-source-versions.mjs"
  },
  "workspaces": [
    "homeos",
    "homeos/frontend",
    "packages/shared",
    "homeos-store"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.22.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.4.3",
    "valibot": "1.5.0",
    "find-my-way": "9.10.0",
    "fast-uri": "3.1.8",
    "file-type": "22.1.1",
    "socket.io-parser": "4.2.7",
    "multer": "2.4.0",
    "nanoid": "3.3.20",
    "pg": "8.23.1",
    "postcss": "8.5.29",
    "typescript": "6.0.3",
    "pinia": "4.0.3",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "javascript-obfuscator": "^5.9.0",
    "knip": "^6.41.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
