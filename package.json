{
  "name": "homeos-monorepo",
  "private": true,
  "version": "0.7.2",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run build:vite && bun run obfuscate",
    "build:backend": "python3 ops/build.py backend",
    "build:vite": "bun run --cwd homeos build && bun run --cwd homeos-store build",
    "build:app": "bun run --cwd homeos build && bun run obfuscate:app",
    "build:store": "bun run --cwd homeos-store build && bun run obfuscate:store",
    "obfuscate": "bun ops/docker/obfuscate_javascript.mjs dist/homeos/frontend/static dist/homeos/frontend/assets dist/homeos/frontend/modules/runtime dist/homeos-store/frontend/static",
    "obfuscate:app": "bun ops/docker/obfuscate_javascript.mjs dist/homeos/frontend/static dist/homeos/frontend/assets dist/homeos/frontend/modules/runtime",
    "obfuscate:store": "bun ops/docker/obfuscate_javascript.mjs dist/homeos-store/frontend/static",
    "image": "python3 ops/build.py image",
    "image:app": "python3 ops/build.py image --project app",
    "image:store": "python3 ops/build.py image --project store",
    "typecheck": "bun run --cwd homeos typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:py": "bun run --cwd homeos typecheck:py",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "knip": "knip --reporter compact",
    "verify:scene": "python3 ops/verify_scene_sync.py",
    "verify:features": "python3 ops/check_feature_codes.py",
    "verify:contracts": "python3 ops/check_shared_contracts.py",
    "verify:schema": ".venv-store/bin/python ops/check_schema.py",
    "verify:database": ".venv-store/bin/python ops/check_database.py",
    "verify:smoke": ".venv-store/bin/python homeos-store/scripts/smoke_store.py && .venv-store/bin/python homeos-store/scripts/_schema_drift_guard_smoke.py",
    "verify:smoke:app": ".venv-store/bin/python homeos/backend/scripts/_auth_contract_smoke.py && .venv-store/bin/python homeos/backend/scripts/_register_login_activate_smoke.py && .venv-store/bin/python homeos/backend/scripts/_p51_ha_whitelist_smoke.py && .venv-store/bin/python homeos/backend/scripts/_ha_fetch_resilience_smoke.py && .venv-store/bin/python homeos/backend/scripts/_schema_drift_guard_smoke.py && .venv-store/bin/python homeos/backend/scripts/_module_feature_gate_smoke.py && .venv-store/bin/python homeos/backend/scripts/_license_activation_e2e_smoke.py",
    "verify:smoke:frontend": "bun run homeos/frontend/scripts/_esc_stack_smoke.ts && bun run homeos/frontend/scripts/_entity_control_logic_smoke.ts",
    "verify:smoke:license": ".venv-store/bin/python homeos/backend/scripts/_license_activation_e2e_smoke.py",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:app": "bun run --cwd homeos dev",
    "dev:store": "bun run --cwd homeos-store dev"
  },
  "workspaces": [
    "homeos",
    "homeos/frontend",
    "homeos/packages/shared",
    "homeos-store"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.22.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.4.3",
    "valibot": "1.5.0",
    "find-my-way": "9.9.0",
    "fast-uri": "3.1.8",
    "file-type": "22.1.1",
    "socket.io-parser": "4.2.7",
    "multer": "2.4.0",
    "nanoid": "3.3.20",
    "pg": "8.23.1",
    "postcss": "8.5.29",
    "typescript": "6.0.3",
    "pinia": "4.0.3",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "javascript-obfuscator": "^5.9.0",
    "knip": "^6.40.0",
    "typescript": "^6.0.3"
  }
}
