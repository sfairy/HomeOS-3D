{
  "name": "homeos-monorepo",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run build:frontend && bun run build:backend",
    "build:shared": "bun run --cwd packages/shared build",
    "build:frontend": "bun run build:vite && bun run minify:static-css && bun run precompress:static",
    "minify:static-css": "node ops/scripts/minify-static-css.mjs",
    "precompress:static": "node ops/scripts/precompress-static.mjs",
    "check:precompress": "node ops/scripts/precompress-static.mjs --check",
    "build:backend": "node ops/lib/py.mjs ops/build.py backend",
    "build:vite": "bun run build:shared && bun run --cwd homeos build && bun run --cwd homeos-store build",
    "build:app": "bun run --cwd packages/shared sync:scene && bun run --cwd homeos build",
    "build:store": "bun run --cwd packages/shared sync:scene && bun run --cwd homeos-store build",
    "check:scene": "bun run --cwd packages/shared check:scene",
    "setup:hooks": "git config core.hooksPath .githooks",
    "set-version": "bun ops/release/set-version.mjs",
    "clean:local": "bun ops/dev/clean-local.mjs",
    "image": "node ops/lib/py.mjs ops/build.py image",
    "image:app": "node ops/lib/py.mjs ops/build.py image --project app",
    "image:store": "node ops/lib/py.mjs ops/build.py image --project store",
    "typecheck": "bun run build:shared && bun run --cwd homeos typecheck && bun run --cwd homeos-store typecheck",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "gate": "node ops/gates.mjs",
    "gate:static": "node ops/gates.mjs --group static",
    "gate:model": "node ops/gates.mjs --group model",
    "gate:build": "node ops/gates.mjs --group build",
    "gate:infra": "node ops/gates.mjs --group infra",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint:py": "node ops/lib/py.mjs -m ruff check .",
    "dev": "bun ops/dev.mjs",
    "dev:prepare": "bun ops/dev.mjs --prepare",
    "dev:runtime": "bun run --cwd homeos dev:runtime",
    "dev:backend": "bun ops/dev.mjs --backend-only",
    "dev:frontend": "bun run --cwd homeos dev:frontend",
    "dev:store": "bun run --cwd homeos-store dev",
    "check:any": "node ops/checks/check_any_baseline.mjs",
    "update:any-baseline": "node ops/checks/check_any_baseline.mjs --update",
    "check:frontend-complexity": "node ops/checks/check_frontend_complexity.mjs --check",
    "update:frontend-complexity-baseline": "node ops/checks/check_frontend_complexity.mjs --update",
    "check:duplicates": "node ops/checks/check_duplicates.mjs",
    "check:code-size": "node ops/checks/code-size.mjs --check ops/checks/code-size-baseline.json",
    "report:compression": "node ops/checks/compression-report.mjs",
    "update:code-size-baseline": "node ops/checks/code-size.mjs --write --out ops/checks/code-size-baseline.json",
    "check:css-duplicates": "node ops/scripts/merge-css-duplicates.mjs --check",
    "check:dom-factory": "node ops/checks/dom-factory-equivalence.mjs",
    "check:geometry-calls": "node ops/checks/geometry-call-golden.mjs --check",
    "check:plan-geometry": "node ops/checks/plan-geometry-invariants.mjs",
    "check:plan-geometry-mutations": "node ops/checks/plan-geometry-mutation-check.mjs",
    "update:duplication-baseline": "node ops/checks/check_duplicates.mjs --update",
    "check:styles": "node ops/checks/check_hardcoded_styles.mjs",
    "update:styles-baseline": "node ops/checks/check_hardcoded_styles.mjs --update",
    "check:licenses": "node ops/checks/check_dependency_licenses.mjs",
    "check:silent-except": "node ops/lib/py.mjs ops/checks/check_silent_except.py",
    "check:async-db": "node ops/lib/py.mjs ops/checks/check_async_db.py",
    "check:python-lock": "node ops/lib/py.mjs ops/ci/python_lock.py verify",
    "check:image-imports": "node ops/lib/py.mjs ops/ci/image_imports.py",
    "check:pep758-except": "node ops/lib/py.mjs ops/checks/check_pep758_except.py",
    "check:cython": "node ops/lib/py.mjs ops/ci/cython_check.py",
    "check:frontend-deps": "bun run --cwd homeos/frontend check:deps && node ops/checks/frontend/check_frontend_deps.mjs --root homeos-store/frontend/src --alias '@store/='",
    "check:restricted-syntax": "node ops/checks/frontend/check_restricted_syntax.mjs",
    "check:canvas-breakpoints": "node ops/checks/frontend/check_canvas_breakpoints.mjs",
    "audit:scaling": "node ops/checks/frontend/audit-scaling.mjs",
    "check:backend-deps": "node ops/lib/py.mjs ops/checks/architecture/check_backend_deps.py --check",
    "check:ws-auth": "node ops/lib/py.mjs ops/checks/security/check_ws_auth.py --check",
    "check:routes": "node ops/lib/py.mjs ops/checks/architecture/route_inventory.py --check",
    "check:store-routes": "node ops/lib/py.mjs ops/checks/architecture/store_route_inventory.py --check",
    "check:api-contract": "node ops/lib/py.mjs ops/checks/architecture/api_contract_coverage.py",
    "check:extra-types": "node ops/lib/py.mjs ops/checks/check_extra_types_parity.py --check",
    "check:file-size": "node ops/lib/py.mjs ops/checks/check_file_size.py",
    "check:complexity": "node ops/lib/py.mjs ops/checks/check_complexity.py --check",
    "check:python-format": "node ops/lib/py.mjs ops/checks/check_python_format.py",
    "check:font-subset": "node homeos-store/frontend/scripts/build-font-subset.mjs --check",
    "generate:font-subset": "node homeos-store/frontend/scripts/build-font-subset.mjs --write",
    "check:chunk-init": "bun ops/checks/check_chunk_init_order.mjs --strict",
    "check:studio-split": "node ops/checks/studio/check_split_budget.mjs --phase 3 && node ops/checks/studio/verify_item_model.mjs",
    "audit:materials": "bun ops/checks/studio/audit_glb_materials.mjs",
    "check:materials": "bun ops/checks/studio/audit_glb_materials.mjs --check",
    "check:models-layout": "bun homeos/frontend/scripts/models/organize-models.mjs --check",
    "organize:models": "bun homeos/frontend/scripts/models/organize-models.mjs --write",
    "index:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs",
    "check:model-names": "bun homeos/frontend/scripts/models/build-model-name-index.mjs --check",
    "check:geometry": "bun ops/checks/studio/audit_glb_geometry.mjs --check",
    "check:slots": "bun ops/checks/studio/audit_glb_material_slots.mjs --check",
    "check:slot-roles": "bun ops/checks/studio/verify_slot_roles.mjs",
    "check:assets": "bun ops/checks/studio/audit_glb_assets.mjs --check",
    "rebuild:items": "bun homeos/frontend/scripts/models/rebuild-items.mjs --all --write",
    "build:slot-contracts": "bun homeos/frontend/scripts/models/build-slot-contracts.mjs",
    "compose:public": "node ops/lib/py.mjs ops/ci/compose_public.py",
    "generate:slot-tables": "bun ops/checks/studio/repair_glb_material_slots.mjs --emit-generated"
  },
  "workspaces": [
    "homeos",
    "homeos/frontend",
    "packages/shared",
    "homeos-store"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.22.1",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.5.0",
    "valibot": "1.5.0",
    "find-my-way": "9.10.0",
    "fast-uri": "4.2.3",
    "follow-redirects": "1.16.2",
    "minimatch": "11.0.4",
    "file-type": "22.3.0",
    "socket.io-parser": "4.2.7",
    "multer": "2.5.0",
    "nanoid": "3.3.20",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "typescript": "6.0.3",
    "pinia": "4.1.0",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "draco3dgltf": "^1.5.9",
    "esbuild": "^0.28.2",
    "jscpd": "5.4.3",
    "lightningcss": "^1.33.0",
    "meshoptimizer": "^1.1.1",
    "pinia": "^4.1.0",
    "postcss": "^8.5.32",
    "three": "0.187.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
