{
  "minLines": 10,
  "minTokens": 50,
  "mode": "weak",
  "format": ["typescript", "javascript", "vue", "python"],
  "reporters": ["json", "html"],
  "output": "docs/analysis/code-duplication/report",
  "absolute": true,
  "gitignore": false,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/out/**",
    "**/vendor/**",
    "**/.venv/**",
    "**/.venv-store/**",
    "**/__pycache__/**",
    "**/.graphflow/**",
    "**/.ruff_cache/**",
    "**/.git/**",
    "**/backups/**",
    "**/public/**",
    "**/assets/**",
    "**/assets-default/**",
    "**/data/**",
    "**/keys/**",
    "**/docs/**",
    "**/*.min.*",
    "**/*.d.ts",
    "**/*.generated.*",
    "**/*.pyi",
    "**/homeos/frontend/src/studio/shims/**"
  ]
}
