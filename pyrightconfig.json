{
  // 开发用的是仓库根的 .venv-store（见 ops/dev.mjs 的 VENV_DIR）。它的名字不是
  // .venv / venv / env，Pylance 的自动发现认不出来，不在这里点名就会退回系统
  // Python —— 那里没有 httpx / sqlalchemy / fastapi / cryptography，于是
  // backend 里每个第三方 import 都报无法解析，并连带一片属性错误。
  "venvPath": ".",
  "venv": ".venv-store",

  // 基础档位挡住大面积的「类型严谨度建议」噪音。不固定档位时分析器会跑到高严格档，
  // 把 reportAny / reportUnknown* / reportMissingTypeArgument /
  // reportUnannotatedClassAttribute 等全量上报（实测 9000+ 条），信号被淹没。
  "typeCheckingMode": "basic",

  // 但 basic 会连带关掉一批「能抓到真 bug」的规则，这里按项决定去留。
  // 依据：全仓实测打开后多报 47 条，逐条核对的结果如下。
  //
  // 保留（本仓确有真问题或零误报）：
  "reportDeprecated": "warning",  // 命中 3 处：@contextmanager 用 Iterator 标注已弃用 → 已改为 Generator
  "reportImportCycles": "warning",  // 命中 7 处 payments/* 之间的环：真实架构信号，保留可见
  "reportUninitializedInstanceVariable": "error",  // 属性从未初始化 → 运行期 AttributeError
  "reportPossiblyUnboundVariable": "error",  // 条件分支里可能未赋值 → UnboundLocalError
  "reportUnusedImport": "warning",  // 死导入
  //
  // 关闭（实测 100% 是本仓结构导致的误报，开着只会训练人忽略告警）：
  //   reportUnreachable       —— 6 处全为误报：闭包内赋值（run() 里改 failure）、
  //                              pyright 对 dict 取值的窄化、以及不认识 stdlib 会抛异常。
  //   reportUnnecessaryComparison —— 9 处全为「防守式 None 判断」：类型标注偏窄
  //                              （DB 列实际可空、字段延迟初始化），代码本身是对的。
  //                              要根治得放宽模型标注，是另一件事，不该用告警替代。
  //   reportAttributeAccessIssue / reportArgumentType —— 即使显式设为 error，在 basic
  //                              底座下也复现不出，说明它们只在 reportUnknown* 开启时涌现。

  // 虚拟环境与缓存目录里有大量第三方源码，不该参与本仓库的诊断。
  // `源代码/` 同理：那是本地逆向恢复出来的发布产物快照（已 gitignore，CI 上没有），
  // 既不是我们的代码，又会把报告撑过 `run.mjs` 的捕获上限、并在反混淆产物里
  // 命中 reportPossiblyUnboundVariable 这类「必为 bug」的硬失败规则。
  "exclude": [".venv-store", "**/node_modules", "**/__pycache__", "dist", "源代码"],

  // 但 exclude 只挡「批量扫描」：dist/ 里的文件一旦在编辑器里打开，分析器仍会单独分析它，
  // 而产物里只剩加密后的 .so（包名 app），解析不了，于是必然报
  // reportMissingImports。
  // ignore 与 exclude 的区别正在这里：它连「已包含 / 已打开文件」的诊断一起压掉。
  "ignore": ["dist"],

  // 仓库根与 ops 下的脚本在运行时会自行把 import 根注入 sys.path，静态分析看不到
  // 这一步，于是 src.* 一律报 reportMissingImports。
  //
  // 两个应用都有同名的 src 包，全局放开的话，后端代码里写错的 src.* 导入会被另一边的
  // 同名模块“接住”而不再报错，所以只给真正需要的环境点名。
  //
  // `packages/shared-py` 同理：两个后端导入的 homeos_shared 由 src/__init__.py 在运行期挂上
  // sys.path（镜像态则靠 PYTHONPATH=/app 里那份内联产物），静态分析同样看不到，故逐个执行
  // 环境点名。它不属于任何一方，所以每个环境都要挂，不存在「两边同名撞车」的问题。
  // 环境是**从头到尾按顺序**比的：每个文件只归属一条 —— `root` 包含该文件的**第一条**
  // （官方口径 "the first one whose root directory contains that file"，不是最长 / 最具体那条）。
  // 所以兜底环境 `root: "."` 必须排在最后：它一旦在前面，下面每条专用环境都轮不到生效，
  // 「运行期才注入 import 根」的文件照样全量报 reportMissingImports（实测全仓 53 条）。
  "executionEnvironments": [
    {
      "root": "ops",
      // 顺序即解析顺序：`src` 包在两个后端同名，ops 下的测试只有主应用那份才含
      // `domains.*`（商店侧 src 只有 api/commerce/core/licensing），所以主应用放前面，
      // 商店侧留作兜底。两边都没有静态 `src.*` 导入，不会互相“接住”写错的导入。
      "extraPaths": [".", "homeos/backend", "homeos-store/backend", "packages/shared-py"]
    },
    {
      // 兜底环境：两个后端源码与 packages/** 都落在这里（上面那条只覆盖 ops）。
      // **必须留在最后** —— 匹配规则见上，它排在前会让上面那条失效。
      "root": ".",
      "extraPaths": ["packages/shared-py"]
    }
  ]
}
