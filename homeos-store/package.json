{
  "name": "homeos-store",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run --cwd ../packages/shared sync:scene && vite --config frontend/vite.config.ts",
    "build": "bun run --cwd ../packages/shared sync:scene && vite build --config frontend/vite.config.ts",
    "typecheck": "node ../ops/lib/run-vue-tsc.mjs -p tsconfig.json --pretty false --noEmit",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0 && node ../ops/lib/check-css-syntax.mjs frontend/src",
    "check:css": "node ../ops/lib/check-css-syntax.mjs frontend/src"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@homeos/shared": "workspace:*",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
