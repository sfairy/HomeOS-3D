{
  "name": "homeos-store",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "node ../ops/run-vue-tsc.mjs -p tsconfig.json --pretty false --noEmit",
    "lint": "eslint \"frontend/src/**/*.{ts,vue}\" --fix",
    "lint:ci": "eslint \"frontend/src/**/*.{ts,vue}\" --max-warnings 0",
    "check:store-deps": "node scripts/check-store-deps.mjs",
    "check:refs": "node ../homeos/frontend/scripts/check-import-refs.mjs --root frontend --alias @store/",
    "check:deps": "node ../ops/lib/run-chain.mjs scripts/deps-gates.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@homeos/shared": "workspace:*",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5",
    "vue-router": "^5.4.0"
  }
}
