.DS_Store
.idea/

# 数据库与 Python 运行时
*.db
*.db-wal
*.db-shm
.venv/
.venv-store/
__pycache__/
*.py[cod]

# 运行时数据与私钥（含旧路径，避免残留被误提交）
data/
homeos/data/
homeos-store/data/
homeos-store/keys/local/
homeos-store/backend/src/data/
homeos-store/backend/src/keys/local/

# homeos 应用密钥/素材：真实口令只提交 .gitkeep 占位
homeos/image/
homeos/keys/*
!homeos/keys/.gitkeep
homeos/secrets/*
!homeos/secrets/.gitkeep
*-private.pem

# 构建期生成的版本模块（真源是仓库根 package.json 的 version）
homeos/backend/src/_version.py
homeos-store/backend/src/_version.py

# 本地配置与凭据
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo
.ruff_cache/
.pnpm-store/

# 系统导出包（hub 备份，含真实用户与布局数据）
homeos-bundle-*.json

# 容器部署的备份包目录（compose 把 ./backups bind mount 到 /data/backups）。
# 里面是整库快照与加密导出包，只能在现场保留，永远不入库。
backups/*
!backups/.gitkeep

# 容器部署的 UI 素材实例目录（compose 把 ./assets bind mount 到 /app/assets）。
# 镜像内置的默认素材是仓库里的 homeos/assets（构建进 /app/assets-default），
# 这里是**运行期副本**：管理员会在现场替换图标 / 背景图 / 音效 / Logo，
# 属主与内容都随机器而变，所以只保留目录占位，不跟踪内容。
assets/*
!assets/.gitkeep

# 客户分发包（导出的 customer-pack / 打包脚本默认输出到 build/）
/build/

# 开发期临时/备份/日志残留
*.bak
*.bak-*
*.log

# 本地清理扫描报告（knip / eslint / ruff 基线输出）
ops/cleanup-reports/

# UI 审计分册（历史产物，已废弃）
docs/

# 逆向恢复出来的历史源码快照
源代码/

# 本地 GraphFlow 会话 / 索引缓存 / 导出产物 / 临时视觉探针（不入库）
.graphflow/
.graphflow-cache/
graphflow-out/
.slider-check.html
