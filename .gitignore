.DS_Store
.idea/

# 数据库与 Python 运行时
*.db
*.db-wal
*.db-shm
.venv/
.venv-store/
__pycache__/
*.py[cod]

# 运行时数据与私钥（含旧路径，避免残留被误提交）
data/
homeos/data/
homeos-store/data/
homeos-store/keys/local/
homeos-store/backend/src/data/
homeos-store/backend/src/keys/local/

# homeos 应用密钥/素材：真实口令只提交 .gitkeep 占位
homeos/image/
homeos/keys/*
!homeos/keys/.gitkeep
homeos/secrets/*
!homeos/secrets/.gitkeep
*-private.pem

# 构建期生成的版本模块（真源是仓库根 package.json 的 version）
homeos/backend/src/_version.py
homeos-store/backend/src/_version.py

# 本地配置与凭据
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo
.pytest_cache/
.ruff_cache/
.pnpm-store/

# 系统导出包（hub 备份，含真实用户与布局数据）
homeos-bundle-*.json

# 客户分发包（ops/deploy/pack-customer.sh 默认输出到 build/customer-pack）
/build/

# 开发期临时/备份/日志残留
*.bak
*.bak-*
*.log

# 本地清理扫描报告（knip / eslint / ruff 基线输出）
ops/cleanup-reports/

# 逆向恢复出来的历史源码快照
源代码/
